// ==============================================================================
// Module Name  : Update Device Stage (Form Link Name: Update_Device_Stage)
// Script Type  : Stateless Form Action (On Click of Submit)
// Trigger Hook : Form Actions -> Submit Button -> On Click
// File Path    : scripts/05_devices/5_1_Update_Device_Stage_onclick_submit.deluge
// Fields Used  : [Select_Devices, New_Device_Stage]
// Cross-Forms  : [Devices]
// Purpose      : Validates selected devices and target stage. Fetches device records
//                in a single batch query, iterates through each device, and applies
//                the target stage. Automatically harmonizes stage choices between
//                Control Units and Overlays (e.g. converting a CU stage to its exact
//                counterpart OV stage for any Overlays in the batch). Updates all
//                records and redirects cleanly to All_Devices report.
// Optimization : Single batch fetch [ID in dev_ids] prevents statement exhaustion.
//                Safe and efficient for 100+ units in a single operation.
// ==============================================================================

// 1. Mandatory Input Validation
if(input.Select_Devices == null || input.Select_Devices.isEmpty())
{
    alert "Please select at least one device to update.";
    cancel submit;
}

if(input.New_Device_Stage == null || input.New_Device_Stage == "")
{
    alert "Please select the target stage in 'New Device Stage'.";
    cancel submit;
}

// 2. Single Batch Query to retrieve all selected device records
dev_ids = input.Select_Devices;
selected_devs = Devices[ID in dev_ids];

if(selected_devs.count() == 0)
{
    alert "No matching device records found for the selected IDs.";
    cancel submit;
}

// 3. Batch Update with Automatic Hardware Stage Harmonization
stg = input.New_Device_Stage;
updated_count = 0;

for each dev in selected_devs
{
    d_type = dev.Device_Type;
    target_stg = stg;
    
    // Fallback detection from serial number if Device_Type is not populated
    if(d_type == null || d_type == "")
    {
        sn = dev.Serial_Number;
        if(sn != null && sn.contains("CU"))
        {
            d_type = "Control Unit";
        }
        else if(sn != null && sn.contains("OV"))
        {
            d_type = "Overlay";
        }
    }
    
    // CASE 1: Device is an OVERLAY, but user selected a CONTROL UNIT stage
    if(d_type == "Overlay" && stg.contains("CU"))
    {
        if(stg == "0 - CU Mfg Not Yet Started")
        {
            target_stg = "0 - OV Mfg Not Yet Started";
        }
        else if(stg == "1 - CU Enclosure Mfg in Progress")
        {
            target_stg = "1 - OV in Screen printing/Welding";
        }
        else if(stg == "2 - CU Subsystems Assembled")
        {
            target_stg = "2 - OV in Stitching";
        }
        else if(stg == "3 - CU Yet to Assemble")
        {
            target_stg = "3 - OV Yet to Assemble";
        }
        else if(stg == "4 - CU Assembly in Progress")
        {
            target_stg = "4 - OV Assembly In Progress";
        }
        else if(stg == "5 - CU Assembly Completed & Not Tested")
        {
            target_stg = "5 - OV Assembly Completed & Not Tested";
        }
        else if(stg == "6 - CU Ready Condition")
        {
            target_stg = "6 - OV Ready Condition";
        }
        else if(stg == "CU Retesting Needed")
        {
            target_stg = "OV Retesting Needed";
        }
        else if(stg == "CU Repair Needed")
        {
            target_stg = "OV Repair Needed";
        }
        else if(stg == "CU Disinfection Needed")
        {
            target_stg = "OV Disinfection Needed";
        }
    }
    // CASE 2: Device is a CONTROL UNIT, but user selected an OVERLAY stage
    else if(d_type == "Control Unit" && stg.contains("OV"))
    {
        if(stg == "0 - OV Mfg Not Yet Started")
        {
            target_stg = "0 - CU Mfg Not Yet Started";
        }
        else if(stg == "1 - OV in Screen printing/Welding")
        {
            target_stg = "1 - CU Enclosure Mfg in Progress";
        }
        else if(stg == "2 - OV in Stitching")
        {
            target_stg = "2 - CU Subsystems Assembled";
        }
        else if(stg == "3 - OV Yet to Assemble")
        {
            target_stg = "3 - CU Yet to Assemble";
        }
        else if(stg == "4 - OV Assembly In Progress")
        {
            target_stg = "4 - CU Assembly in Progress";
        }
        else if(stg == "5 - OV Assembly Completed & Not Tested")
        {
            target_stg = "5 - CU Assembly Completed & Not Tested";
        }
        else if(stg == "6 - OV Ready Condition")
        {
            target_stg = "6 - CU Ready Condition";
        }
        else if(stg == "OV Retesting Needed")
        {
            target_stg = "CU Retesting Needed";
        }
        else if(stg == "OV Repair Needed")
        {
            target_stg = "CU Repair Needed";
        }
        else if(stg == "OV Disinfection Needed")
        {
            target_stg = "CU Disinfection Needed";
        }
    }
    
    // Direct property update on fetched record
    dev.Device_Stage = target_stg;
    updated_count = updated_count + 1;
}

// 4. User Feedback & View Refresh
alert "Successfully updated stage for " + updated_count + " device(s).";
openUrl("#Report:All_Devices", "same window");
