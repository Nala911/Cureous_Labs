// ==============================================================================
// Module Name  : Devices (Report Link Name: All_Devices)
// Script Type  : Report Custom Action Function (Workflow Action Item)
// Trigger Hook : Report Actions -> For Multiple Records -> Update Stage
// File Path    : scripts/05_devices/report_all_devices/5_1_All_Devices_customaction_open_update_stage.deluge
// Fields Used  : [ID, Device_State]
// Cross-Forms  : [Update_Device_Stage]
// Purpose      : Validates that none of the selected rows are actively deployed
//                (Rentally Active / Active in Demo) and launches Update_Device_Stage
//                in a popup modal with Select_Devices pre-filled.
// Optimization : Reads directly from selected report collection. Zero extra query.
// ==============================================================================

void open_update_stage(Devices selected_devices)
{
    sel_count = 0;
    try
    {
        // 1. Validate no actively deployed devices are selected
        id_list = list();
        blocked_count = 0;
        for each dev in selected_devices
        {
            sel_count = sel_count + 1;
            if(dev.Device_State == "Rentally Active" || dev.Device_State == "Active in Demo")
            {
                blocked_count = blocked_count + 1;
            }
            else
            {
                id_list.add(dev.ID);
            }
        }
        
        // 2. Block if any active deployment device is included, otherwise open modal
        if(id_list.size() == 0)
        {
            alert "Please select at least one device to update.";
        }
        else if(blocked_count > 0)
        {
            alert "Update Stage Blocked:\n\n" + blocked_count + " selected device(s) are currently Rentally Active or Active in Demo. Please use Close Deployments or Swap Devices before updating their Device Stage.";
        }
        else
        {
            openUrl("#Form:Update_Device_Stage?Select_Devices=" + id_list, "popup window", "height=600px,width=700px");
        }
    }
    catch (e)
    {
        err_log = thisapp.format_error_log("open_update_stage", "scripts/05_devices/report_all_devices/5_1_All_Devices_customaction_open_update_stage.deluge", "All_Devices -> Update Stage", "" + e.lineNo, "" + e.type, "" + e.message, "selected_count=" + sel_count);
        alert err_log;
    }
}
