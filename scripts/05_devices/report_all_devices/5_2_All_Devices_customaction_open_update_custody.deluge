// ==============================================================================
// Module Name  : Devices (Report Link Name: All_Devices)
// Script Type  : Report Custom Action Function (Workflow Action Item)
// Trigger Hook : Report Actions -> For Multiple Records -> Update Custody
// File Path    : scripts/05_devices/report_all_devices/5_2_All_Devices_customaction_open_update_custody.deluge
// Fields Used  : [ID]
// Cross-Forms  : [Update_Device_Custody]
// Purpose      : Captures selected record IDs from All_Devices report and launches
//                the Update_Device_Custody stateless form modal with pre-selected devices.
// Optimization : Single client-side redirect. Zero statement/query cost.
// ==============================================================================

void open_update_custody(Devices selected_devices)
{
    // 1. Extract all selected record IDs into a list
    id_list = selected_devices.ID.getAll();
    
    // 2. Open the stateless form in a popup modal with the devices pre-filled
    openUrl("#Form:Update_Device_Custody?Select_Devices=" + id_list, "popup window", "height=600px,width=700px");
}
