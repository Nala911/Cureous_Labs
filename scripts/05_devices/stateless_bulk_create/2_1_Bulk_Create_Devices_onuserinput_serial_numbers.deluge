// ==============================================================================
// Module Name  : Bulk Create Devices (Form Link Name: Bulk_Create_Devices)
// Script Type  : Stateless Form Workflow (On User Input)
// Trigger Hook : Field Actions -> Serial_Numbers -> On User Input
// File Path    : scripts/05_devices/stateless_bulk_create/2_1_Bulk_Create_Devices_onuserinput_serial_numbers.deluge
// Fields Used  : [Serial_Numbers, Device_Rows, Reference_Guide]
// Cross-Forms  : [Devices, Lots, Product_Models, Offices]
// Purpose      : Parses pasted serial numbers (newlines, spaces, commas, tabs),
//                auto-populates the editable Device_Rows tabular block with
//                derived Product_Model, default latest Lot, and Stage 0, and
//                updates Reference_Guide with live error/duplicate alerts.
// Optimization : Delegates to generate_bulk_device_rows (single batch DB check).
// ==============================================================================

gen_res = thisapp.generate_bulk_device_rows(input.Serial_Numbers);
if(gen_res.get("_error") != null && gen_res.get("_error") != "")
{
    alert gen_res.get("_error").toString();
}
else
{
    input.Device_Rows = gen_res.get("device_rows_text").toString();
    input.Reference_Guide = gen_res.get("reference_text").toString();
}
