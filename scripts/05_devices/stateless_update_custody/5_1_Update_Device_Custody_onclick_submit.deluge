// ==============================================================================
// Module Name  : Update Device Custody (Form Link Name: Update_Device_Custody)
// Script Type  : Stateless Form Action (On Click of Submit)
// Trigger Hook : Form Actions -> Submit Button -> On Click
// File Path    : scripts/05_devices/stateless_update_custody/5_1_Update_Device_Custody_onclick_submit.deluge
// Fields Used  : [Select_Devices, Destination_Type, Target_Office, Target_Customer]
// Cross-Forms  : [Devices, Deployments]
// Purpose      : Validates selected devices (blocking Rentally Active / Active
//                in Demo / open Deployments, and enforcing 6 - Ready Condition
//                on Customer Deployment) and batch-updates custody & state.
// Optimization : Two batch queries ([ID in dev_ids] and open Deployments check)
//                prevent statement exhaustion even on 100+ selected devices.
// ==============================================================================

// 1. Mandatory Input Validation
is_valid = true;

if(input.Select_Devices == null || input.Select_Devices.isEmpty())
{
    alert "Please select at least one device to transfer custody.";
    is_valid = false;
}
else if(input.Destination_Type == null || input.Destination_Type == "")
{
    alert "Please select the Destination Type.";
    is_valid = false;
}
else if(input.Destination_Type == "Internal Office Transfer" && input.Target_Office == null)
{
    alert "Please select the target branch office.";
    is_valid = false;
}
else if(input.Destination_Type == "Customer Deployment" && input.Target_Customer == null)
{
    alert "Please select the target customer.";
    is_valid = false;
}

if(is_valid)
{
    // 2. Single Batch Query to retrieve all selected device records
    dev_ids = input.Select_Devices;
    selected_devs = Devices[ID in dev_ids];
    
    if(selected_devs.count() == 0)
    {
        alert "No matching device records found for the selected IDs.";
    }
    else
    {
        // 3. Active Deployment & Readiness Safety Pre-Check
        dest_type = input.Destination_Type;
        active_blocked = "";
        not_ready_blocked = "";
        
        open_deps = Deployments[(Control_Unit in dev_ids || Overlay in dev_ids) && Deployment_State != "Closed"];
        open_dep_dev_ids = list();
        for each dep in open_deps
        {
            if(dep.Control_Unit != null)
            {
                dep_cu = dep.Control_Unit;
                if(!open_dep_dev_ids.contains(dep_cu))
                {
                    open_dep_dev_ids.add(dep_cu);
                }
            }
            if(dep.Overlay != null)
            {
                dep_ov = dep.Overlay;
                if(!open_dep_dev_ids.contains(dep_ov))
                {
                    open_dep_dev_ids.add(dep_ov);
                }
            }
        }
        
        for each dev_check in selected_devs
        {
            chk_id = dev_check.ID;
            if(dev_check.Device_State == "Rentally Active" || dev_check.Device_State == "Active in Demo" || open_dep_dev_ids.contains(chk_id))
            {
                if(active_blocked != "")
                {
                    active_blocked = active_blocked + ", ";
                }
                active_blocked = active_blocked + dev_check.Serial_Number;
            }
            else if(dest_type == "Customer Deployment" && dev_check.Device_Stage != "6 - Ready Condition")
            {
                if(not_ready_blocked != "")
                {
                    not_ready_blocked = not_ready_blocked + ", ";
                }
                not_ready_blocked = not_ready_blocked + dev_check.Serial_Number;
            }
        }
        
        if(active_blocked != "")
        {
            alert "Update Custody Blocked:\n\nDevice(s) currently linked to an active deployment: " + active_blocked + ".\nPlease use Close Deployments or Swap Devices first.";
        }
        else if(not_ready_blocked != "")
        {
            alert "Customer Deployment Blocked:\n\nDevice(s) not at '6 - Ready Condition': " + not_ready_blocked + ".";
        }
        else
        {
            // 4. Batch Custody & State Synchronization
            updated_count = 0;
            
            if(dest_type == "Internal Office Transfer")
            {
                office_id = input.Target_Office;
                for each dev in selected_devs
                {
                    dev.Current_Office = office_id;
                    dev.Current_Customer = null;
                    dev.Device_State = "Available in Stock";
                    updated_count = updated_count + 1;
                }
            }
            else if(dest_type == "Customer Deployment")
            {
                cust_id = input.Target_Customer;
                for each dev in selected_devs
                {
                    dev.Current_Customer = cust_id;
                    dev.Current_Office = null;
                    dev.Device_State = "Rentally Active";
                    updated_count = updated_count + 1;
                }
            }
            
            // 5. User Feedback & View Refresh
            alert "Successfully updated custody for " + updated_count + " device(s).";
            openUrl("#Report:All_Devices", "same window");
        }
    }
}
