// ==============================================================================
// Module Name  : Update Device Custody (Form Link Name: Update_Device_Custody)
// Script Type  : Stateless Form Action (On Click of Submit)
// Trigger Hook : Form Actions -> Submit Button -> On Click
// File Path    : scripts/05_devices/stateless_update_custody/5_1_Update_Device_Custody_onclick_submit.deluge
// Fields Used  : [Select_Devices, Target_Office, Target_Customer]
// Cross-Forms  : [Devices, Deployments]
// Purpose      : Thin UI wrapper calling handle_update_device_custody with
//                try-catch error protection. Alerts only on error; redirects
//                silently to All_Devices on success.
// Optimization : Delegates batch processing to standalone function.
// ==============================================================================

err = thisapp.handle_update_device_custody(input.Select_Devices, input.Target_Office, input.Target_Customer);
if(err != "")
{
    alert err;
}
else
{
    openUrl("#Report:All_Devices", "same window");
}
