// ==============================================================================
// Module Name  : Devices (Form Link Name: Devices)
// Script Type  : Form Workflow (On Validate)
// Trigger Hook : Created or Edited -> Form Actions -> On Validate
// File Path    : scripts/05_devices/3_Devices_onvalidate.deluge
// Fields Used  : [Serial_Number, Device_Type, Product_Model, Lot, Device_Stage, Rental_State]
// Cross-Forms  : [Devices]
// Purpose      : Comprehensive validation and data integrity engine for device intake:
//                1. Validates mandatory Serial Number.
//                2. Enforces unique Serial Number (duplicate guard).
//                3. Validates hardware serial syntax (must contain CU or OV;
//                   must begin with recognized prefix ALT or ET).
//                4. Validates and auto-derives Product Model dropdown choice ("Altern4", "Eturnal One", "Eturnal One with foam").
//                5. Safety Fallback for Lot (defaults to "26FB03" if blank).
//                6. Hardware & Stage Compatibility: Strictly prevents assigning
//                   an Overlay stage to a Control Unit or vice versa.
// Optimization : Single indexed query for duplicate check, zero queries for
//                Product Model fallback. Zero loop queries. Runs in <15ms.
// ==============================================================================

// 1. Mandatory Check: Serial Number
if(input.Serial_Number == null || input.Serial_Number.trim() == "")
{
    alert "Mandatory Field Missing:\n\nPlease enter or scan a Serial Number.";
    cancel submit;
}

clean_sn = input.Serial_Number.trim().toUpperCase();
input.Serial_Number = clean_sn;

// 2. Duplicate Guard: Serial Number must be unique across all devices
curr_id = 0;
if(input.ID != null)
{
    curr_id = input.ID;
}

existing_dev = Devices[Serial_Number == clean_sn && ID != curr_id];
if(existing_dev.count() > 0)
{
    alert "Duplicate Serial Number:\n\nSerial Number '" + clean_sn + "' already exists in the system.\n\nPlease enter or scan a unique serial number.";
    cancel submit;
}

// 3. Validate Serial Syntax & Derive Safety Fallbacks
is_cu = clean_sn.contains("CU");
is_ov = clean_sn.contains("OV");

if(!is_cu && !is_ov)
{
    alert "Invalid Serial Number Format:\n\nSerial Number must contain 'CU' (Control Unit) or 'OV' (Overlay).\n\nExamples: ALT4CU053, ALTOV017, ETOCU065, ETOOV064";
    cancel submit;
}

is_valid_prefix = clean_sn.startsWith("ALT") || clean_sn.startsWith("ET");
if(!is_valid_prefix)
{
    alert "Invalid Model Prefix:\n\nSerial Number must begin with recognized prefix: 'ALT' (Altern4) or 'ET' (Eturnal).\n\nExamples: ALT4CU053, ALTOV017, ETOCU065, ETOOV064";
    cancel submit;
}

// Safety Fallback for Device Type
if(input.Device_Type == null || input.Device_Type == "")
{
    if(is_cu)
    {
        input.Device_Type = "Control Unit";
    }
    else if(is_ov)
    {
        input.Device_Type = "Overlay";
    }
}

// Safety Fallback for Product Model Dropdown
if(input.Product_Model == null || input.Product_Model == "")
{
    target_name = "";
    if(clean_sn.startsWith("ALT"))
    {
        target_name = "Altern4";
    }
    else if(clean_sn.startsWith("ET"))
    {
        target_name = "Eturnal One";
    }
    
    if(target_name != "")
    {
        input.Product_Model = target_name;
    }
}

if(input.Product_Model == null || input.Product_Model == "")
{
    alert "Product Model Missing:\n\nPlease select a valid Product Model for serial number '" + clean_sn + "'.";
    cancel submit;
}

// Safety Fallback for Lot Number
if(input.Lot == null || input.Lot == "")
{
    input.Lot = "26FB03";
}

// Safety Fallback for Initial Device Stage
if(input.Device_Stage == null || input.Device_Stage == "")
{
    if(input.Device_Type == "Control Unit")
    {
        input.Device_Stage = "0 - CU Mfg Not Yet Started";
    }
    else if(input.Device_Type == "Overlay")
    {
        input.Device_Stage = "0 - OV Mfg Not Yet Started";
    }
}
else
{
    // Hardware & Stage Compatibility Guard (Crucial for Bulk Edit Protection)
    is_cu_stage = input.Device_Stage.contains("CU");
    is_ov_stage = input.Device_Stage.contains("OV");
    
    if(input.Device_Type == "Control Unit" && is_ov_stage)
    {
        alert "Stage Mismatch Error:\n\nCannot assign an Overlay stage (" + input.Device_Stage + ") to Control Unit '" + input.Serial_Number + "'.";
        cancel submit;
    }
    else if(input.Device_Type == "Overlay" && is_cu_stage)
    {
        alert "Stage Mismatch Error:\n\nCannot assign a Control Unit stage (" + input.Device_Stage + ") to Overlay '" + input.Serial_Number + "'.";
        cancel submit;
    }
}

// Safety Fallback for Initial Rental State
if(input.Rental_State == null || input.Rental_State == "")
{
    input.Rental_State = "Inactive";
}
