// ==============================================================================
// Module Name  : Devices (Form Link Name: Devices)
// Script Type  : Field Update Workflow (On Update)
// Trigger Hook : Edited -> Field Actions -> Device_Stage -> On Update
// File Path    : scripts/05_devices/form_devices/2_2_Devices_onupdate_devicestage.deluge
// Fields Used  : [Serial_Number, Device_Type, Device_Stage]
// Cross-Forms  : None
// Purpose      : Auto-harmonizes and enforces stage-hardware compatibility during
//                individual and bulk edits. If an Overlay receives a Control Unit
//                stage (or vice-versa), automatically converts it to the exact
//                counterpart stage, guaranteeing zero data corruption.
// Optimization : Pure in-memory string evaluation. Zero database queries. Runs in <2ms.
// ==============================================================================

if(input.Device_Stage != null && input.Device_Stage != "")
{
    // 1. Resolve Device Type
    d_type = input.Device_Type;
    if(d_type == null || d_type == "")
    {
        if(input.Serial_Number != null && input.Serial_Number.contains("CU"))
        {
            d_type = "Control Unit";
        }
        else if(input.Serial_Number != null && input.Serial_Number.contains("OV"))
        {
            d_type = "Overlay";
        }
    }
    
    stg = input.Device_Stage;
    
    // 2. CASE 1: Device is an OVERLAY, but received a CONTROL UNIT stage
    if(d_type == "Overlay" && stg.contains("CU"))
    {
        if(stg == "0 - CU Mfg Not Yet Started")
        {
            input.Device_Stage = "0 - OV Mfg Not Yet Started";
        }
        else if(stg == "1 - CU Enclosure Mfg in Progress")
        {
            input.Device_Stage = "1 - OV in Screen printing/Welding";
        }
        else if(stg == "2 - CU Subsystems Assembled")
        {
            input.Device_Stage = "2 - OV in Stitching";
        }
        else if(stg == "3 - CU Yet to Assemble")
        {
            input.Device_Stage = "3 - OV Yet to Assemble";
        }
        else if(stg == "4 - CU Assembly in Progress")
        {
            input.Device_Stage = "4 - OV Assembly In Progress";
        }
        else if(stg == "5 - CU Assembly Completed & Not Tested")
        {
            input.Device_Stage = "5 - OV Assembly Completed & Not Tested";
        }
        else if(stg == "6 - CU Ready Condition")
        {
            input.Device_Stage = "6 - OV Ready Condition";
        }
        else if(stg == "CU Retesting Needed")
        {
            input.Device_Stage = "OV Retesting Needed";
        }
        else if(stg == "CU Repair Needed")
        {
            input.Device_Stage = "OV Repair Needed";
        }
        else if(stg == "CU Disinfection Needed")
        {
            input.Device_Stage = "OV Disinfection Needed";
        }
    }
    // 3. CASE 2: Device is a CONTROL UNIT, but received an OVERLAY stage
    else if(d_type == "Control Unit" && stg.contains("OV"))
    {
        if(stg == "0 - OV Mfg Not Yet Started")
        {
            input.Device_Stage = "0 - CU Mfg Not Yet Started";
        }
        else if(stg == "1 - OV in Screen printing/Welding")
        {
            input.Device_Stage = "1 - CU Enclosure Mfg in Progress";
        }
        else if(stg == "2 - OV in Stitching")
        {
            input.Device_Stage = "2 - CU Subsystems Assembled";
        }
        else if(stg == "3 - OV Yet to Assemble")
        {
            input.Device_Stage = "3 - CU Yet to Assemble";
        }
        else if(stg == "4 - OV Assembly In Progress")
        {
            input.Device_Stage = "4 - CU Assembly in Progress";
        }
        else if(stg == "5 - OV Assembly Completed & Not Tested")
        {
            input.Device_Stage = "5 - CU Assembly Completed & Not Tested";
        }
        else if(stg == "6 - OV Ready Condition")
        {
            input.Device_Stage = "6 - CU Ready Condition";
        }
        else if(stg == "OV Retesting Needed")
        {
            input.Device_Stage = "CU Retesting Needed";
        }
        else if(stg == "OV Repair Needed")
        {
            input.Device_Stage = "CU Repair Needed";
        }
        else if(stg == "OV Disinfection Needed")
        {
            input.Device_Stage = "CU Disinfection Needed";
        }
    }
}
