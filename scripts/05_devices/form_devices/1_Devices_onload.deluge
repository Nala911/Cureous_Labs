// ==============================================================================
// Module Name  : Devices (Form Link Name: Devices)
// Script Type  : Form Workflow (On Load)
// Trigger Hook : Created or Edited -> Form Actions -> On Load
// File Path    : scripts/05_devices/form_devices/1_Devices_onload.deluge
// Fields Used  : [Serial_Number, Device_Type, Product_Model, Lot, Device_Stage, Device_State, Current_Customer, Current_Office]
// Cross-Forms  : [Lots, Product_Models, Offices]
// Purpose      : In Add mode: Enables Serial_Number, Product_Model, Lot, and
//                Current_Office; auto-selects the latest Lot record ID and
//                defaults Current_Office to "Bangalore Office"; keeps Device_Type
//                disabled for visual context; hides lifecycle fields.
//                In Edit mode: Locks Serial_Number and Product_Model; leaves Lot
//                editable for technician reassignment; enables Device_Stage and
//                dynamically populates only the relevant stages for that hardware
//                (Control Unit vs Overlay) to allow progressive stage updates.
// Optimization : Single indexed queries for latest lot & Bangalore Office on Add mode.
// ==============================================================================

if(input.ID == null)
{
    // 1. ADD Mode: Serial Number, Product Model, Lot & Current Office are interactive
    enable Serial_Number;
    enable Product_Model;
    enable Lot;
    enable Current_Office;
    show Serial_Number;
    show Product_Model;
    show Lot;
    show Current_Office;
    
    // Auto-fill latest Lot record on Add mode (user is allowed to edit/override)
    if(input.Lot == null)
    {
        for each single_lot in Lots[ID != null] sort by Added_Time desc range from 1 to 1
        {
            input.Lot = single_lot.ID;
        }
    }
    
    // Auto-fill Current Office to 'Bangalore Office' on Add mode (user can override)
    if(input.Current_Office == null)
    {
        for each def_off in Offices[Office_Name == "Bangalore Office"] range from 1 to 1
        {
            input.Current_Office = def_off.ID;
        }
    }
    
    // 2. Context Fields: Disabled so user sees hardware classification without editing
    disable Device_Type;
    show Device_Type;
    
    // 3. Lifecycle Fields: Hidden during new device creation
    hide Current_Customer;
    hide Device_Stage;
    hide Device_State;
}
else
{
    // 4. EDIT Mode: Serial Number and Product Model are immutable
    disable Serial_Number;
    disable Product_Model;
    
    // Lot remains editable in Edit mode so technicians can reassign if needed
    enable Lot;
    show Lot;
    
    // Context and lifecycle fields remain locked
    disable Device_State;
    disable Device_Type;
    disable Current_Customer;
    disable Current_Office;
    
    show Device_State;
    show Device_Type;
    show Product_Model;
    show Current_Customer;
    show Current_Office;
    
    // 5. Dynamic Stage Progression: Populate stages based on Device Type
    dev_type = input.Device_Type;
    if(dev_type == null || dev_type == "")
    {
        if(input.Serial_Number != null && input.Serial_Number.contains("CU"))
        {
            dev_type = "Control Unit";
        }
        else if(input.Serial_Number != null && input.Serial_Number.contains("OV"))
        {
            dev_type = "Overlay";
        }
    }
    
    current_stage = input.Device_Stage;
    
    // Clear all static choices so this device only displays its hardware-specific stages
    clear Device_Stage;
    
    if(dev_type == "Control Unit" || dev_type == "Overlay")
    {
        filtered_stages = thisapp.get_device_stages(dev_type);
    }
    else
    {
        filtered_stages = thisapp.get_device_stages("All");
    }
    Device_Stage:ui.add(filtered_stages);
    
    // Re-assert current stage so selection is preserved
    if(current_stage != null && current_stage != "")
    {
        input.Device_Stage = current_stage;
    }
    
    // Technicians can update Device Stage through manufacturing and maintenance,
    // except while the device is actively deployed at a customer bedside.
    show Device_Stage;
    if(input.Device_State == "Rentally Active" || input.Device_State == "Active in Demo")
    {
        disable Device_Stage;
    }
    else
    {
        enable Device_Stage;
    }
}
