// ==============================================================================
// Module Name  : Devices (Form Link Name: Devices)
// Script Type  : Form Workflow (On Validate)
// Trigger Hook : Created or Edited -> Form Actions -> On Validate
// File Path    : scripts/05_devices/form_devices/3_Devices_onvalidate.deluge
// Fields Used  : [Serial_Number, Device_Type, Product_Model, Lot, Device_Stage, Device_State]
// Cross-Forms  : [Devices, Lots, Product_Models]
// Purpose      : Comprehensive validation and data integrity engine for device intake:
//                1. Validates mandatory Serial Number.
//                2. Enforces unique Serial Number (duplicate guard).
//                3. Validates hardware serial syntax (must contain CU or OV;
//                   must begin with recognized prefix ALT or ET).
//                4. Validates and auto-resolves Product Model lookup from Product_Models.
//                5. Safety Fallback for Lot (defaults dynamically to latest record in Lots if blank; guards against submission if no lot exists).
//                6. Hardware & Stage Compatibility: Strictly prevents assigning
//                   an Overlay stage to a Control Unit or vice versa.
// Optimization : Single indexed query for duplicate check, single indexed range
//                query for Lot fallback if unselected. Zero loop queries. Runs in <15ms.
// ==============================================================================

// 1. Mandatory Check: Serial Number
if(input.Serial_Number == null || input.Serial_Number.trim() == "")
{
    alert "Mandatory Field Missing:\n\nPlease enter or scan a Serial Number.";
    cancel submit;
}

clean_sn = input.Serial_Number.trim().toUpperCase();
input.Serial_Number = clean_sn;

// 2. Duplicate Guard: Serial Number must be unique across all devices
curr_id = 0;
if(input.ID != null)
{
    curr_id = input.ID;
}

existing_dev = Devices[Serial_Number == clean_sn && ID != curr_id];
if(existing_dev.count() > 0)
{
    alert "Duplicate Serial Number:\n\nSerial Number '" + clean_sn + "' already exists in the system.\n\nPlease enter or scan a unique serial number.";
    cancel submit;
}

// 3. Validate Serial Syntax & Derive Safety Fallbacks
is_cu = clean_sn.contains("CU");
is_ov = clean_sn.contains("OV");

if(!is_cu && !is_ov)
{
    alert "Invalid Serial Number Format:\n\nSerial Number must contain 'CU' (Control Unit) or 'OV' (Overlay).\n\nExamples: ALT4CU053, ALTOV017, ETOCU065, ETOOV064";
    cancel submit;
}

is_valid_prefix = clean_sn.startsWith("ALT") || clean_sn.startsWith("ET");
if(!is_valid_prefix)
{
    alert "Invalid Model Prefix:\n\nSerial Number must begin with recognized prefix: 'ALT' (Altern4) or 'ET' (Eturnal).\n\nExamples: ALT4CU053, ALTOV017, ETOCU065, ETOOV064";
    cancel submit;
}

// Safety Fallback for Device Type
if(input.Device_Type == null || input.Device_Type == "")
{
    if(is_cu)
    {
        input.Device_Type = "Control Unit";
    }
    else if(is_ov)
    {
        input.Device_Type = "Overlay";
    }
}

// Safety Fallback for Product Model Lookup
if(input.Product_Model == null)
{
    target_name = "";
    if(clean_sn.startsWith("ALT"))
    {
        target_name = "Altern4";
    }
    else if(clean_sn.startsWith("ET"))
    {
        target_name = "Eturnal One";
    }
    
    if(target_name != "")
    {
        for each pm in Product_Models[Product_Model_Name == target_name]
        {
            input.Product_Model = pm.ID;
        }
    }
}

if(input.Product_Model == null)
{
    alert "Product Model Missing:\n\nPlease select a valid Product Model for serial number '" + clean_sn + "'.";
    cancel submit;
}

// Safety Fallback for Lot Lookup
if(input.Lot == null)
{
    for each single_lot in Lots[ID != null] sort by Added_Time desc range from 1 to 1
    {
        input.Lot = single_lot.ID;
    }
}

if(input.Lot == null)
{
    alert "Manufacturing Lot Missing:\n\nPlease select or create a valid Manufacturing Lot before saving.";
    cancel submit;
}

// Safety Fallback for Initial Device Stage
if(input.Device_Stage == null || input.Device_Stage == "")
{
    input.Device_Stage = "0 - Mfg Not Yet Started";
}
else
{
    // Hardware & Stage Compatibility Guard (Stages 1 and 2 only; shared stages apply to both)
    stg = input.Device_Stage;
    is_cu_only = (stg == "1 - CU Enclosure Mfg in Progress" || stg == "2 - CU Subsystems Assembled");
    is_ov_only = (stg == "1 - OV in Screen Printing / Welding" || stg == "2 - OV in Stitching");
    
    if(input.Device_Type == "Control Unit" && is_ov_only)
    {
        alert "Stage Mismatch Error:\n\nCannot assign an Overlay-specific stage (" + stg + ") to Control Unit '" + input.Serial_Number + "'.";
        cancel submit;
    }
    else if(input.Device_Type == "Overlay" && is_cu_only)
    {
        alert "Stage Mismatch Error:\n\nCannot assign a Control Unit-specific stage (" + stg + ") to Overlay '" + input.Serial_Number + "'.";
        cancel submit;
    }
}

// Safety Fallback for Initial Device State
if(input.Device_State == null || input.Device_State == "")
{
    input.Device_State = "Available in Stock";
}
else if(input.ID != null)
{
    if((input.Device_State == "Rentally Active" || input.Device_State == "Active in Demo") && input.Device_Stage != "6 - Ready Condition")
    {
        alert "Active Deployment Lock:\n\nDevice '" + input.Serial_Number + "' is currently '" + input.Device_State + "' and must stay at '6 - Ready Condition'. Use Close Deployments or Swap Devices before changing its stage.";
        cancel submit;
    }
}
