/* ==============================================================================
   Module Name  : Stock Transfers (Form Link Name: Stock_Transfers)
   Script Type  : Form Workflow (On Validate)
   Trigger Hook : Created or Edited -> Form Actions -> On Validate
   File Path    : scripts/07_stock_transfers/3_Stock_Transfers_onvalidate.deluge
   Purpose      : Validates mandatory transfer routing, prevents transferring to the
                  same branch, and enforces that at least one device is selected.
   Optimization : Zero database queries consumed. Runs in <10ms.
============================================================================== */

// 1. Mandatory Transfer Type Check
if(input.Transfer_Type == null || input.Transfer_Type == "")
{
    alert "Validation Error:\n\nPlease select a Transfer Type (Inter Branch, Office to Customer, or Customer to Office).";
    cancel submit;
}

// 2. Validate Directional Routing by Type
if(input.Transfer_Type == "Inter Branch")
{
    if(input.Source_Office == null)
    {
        alert "Validation Error:\n\nPlease select the Source Office (originating branch).";
        cancel submit;
    }
    if(input.Destination_Office == null)
    {
        alert "Validation Error:\n\nPlease select the Destination Office (receiving branch).";
        cancel submit;
    }
    if(input.Source_Office == input.Destination_Office)
    {
        alert "Routing Conflict:\n\nSource Office and Destination Office cannot be the same location.\n\nPlease select two distinct branch locations for Inter Branch transfer.";
        cancel submit;
    }
}
else if(input.Transfer_Type == "Office to Customer")
{
    if(input.Source_Office == null)
    {
        alert "Validation Error:\n\nPlease select the Source Office (dispatching branch).";
        cancel submit;
    }
    if(input.Destination_Customer == null)
    {
        alert "Validation Error:\n\nPlease select the Destination Customer.";
        cancel submit;
    }
}
else if(input.Transfer_Type == "Customer to Office")
{
    if(input.Source_Customer == null)
    {
        alert "Validation Error:\n\nPlease select the Source Customer (returning party).";
        cancel submit;
    }
    if(input.Destination_Office == null)
    {
        alert "Validation Error:\n\nPlease select the Destination Office (receiving branch).";
        cancel submit;
    }
}

// 3. Mandatory Hardware Selection Check
total_devices = ifnull(input.Control_Unit_Number, 0) + ifnull(input.Overlay_Number, 0);
if(total_devices == 0)
{
    alert "Inventory Validation Error:\n\nPlease select at least one Control Unit or Overlay to initiate this transfer.";
    cancel submit;
}

// 4. Ensure Transfer Status is set (Hidden during data entry; auto-defaults to Draft)
if(input.Transfer_Status == null || input.Transfer_Status == "")
{
    input.Transfer_Status = "Draft";
}
