// ==============================================================================
// Module Name  : Stock Transfers (Form Link Name: Stock_Transfers)
// Script Type  : Form Workflow (On Validate)
// Trigger Hook : Created or Edited -> Form Actions -> On Validate
// File Path    : scripts/07_stock_transfers/3_Stock_Transfers_onvalidate.deluge
// Fields Used  : [Transfer_Type, Source_Office, Destination_Office, Source_Customer, Destination_Customer, Devices, Transfer_Status]
// Cross-Forms  : [Devices]
// Purpose      : Validates mandatory transfer routing, prevents transferring to the
//                same branch, ensures Transfer Status is valid, enforces hardware
//                selection, and applies Clinical Safety Guard (only Ready Condition
//                devices can be dispatched to customer facilities).
// Optimization : Minimal indexed queries. Zero try-catch blocks.
// ==============================================================================

// 1. Mandatory Transfer Type Check
if(input.Transfer_Type == null || input.Transfer_Type == "")
{
    alert "Validation Error:\n\nPlease select a Transfer Type (Inter Branch, Office to Customer, or Customer to Office).";
    cancel submit;
}

// 2. Validate Directional Routing by Type
if(input.Transfer_Type == "Inter Branch")
{
    if(input.Source_Office == null)
    {
        alert "Validation Error:\n\nPlease select the Source Office (originating branch).";
        cancel submit;
    }
    if(input.Destination_Office == null)
    {
        alert "Validation Error:\n\nPlease select the Destination Office (receiving branch).";
        cancel submit;
    }
    if(input.Source_Office == input.Destination_Office)
    {
        alert "Routing Conflict:\n\nSource Office and Destination Office cannot be the same office.\n\nPlease select two distinct branch offices for Inter Branch transfer.";
        cancel submit;
    }
}
else if(input.Transfer_Type == "Office to Customer")
{
    if(input.Source_Office == null)
    {
        alert "Validation Error:\n\nPlease select the Source Office (dispatching branch).";
        cancel submit;
    }
    if(input.Destination_Customer == null)
    {
        alert "Validation Error:\n\nPlease select the Destination Customer.";
        cancel submit;
    }
}
else if(input.Transfer_Type == "Customer to Office")
{
    if(input.Source_Customer == null)
    {
        alert "Validation Error:\n\nPlease select the Source Customer (returning party).";
        cancel submit;
    }
    if(input.Destination_Office == null)
    {
        alert "Validation Error:\n\nPlease select the Destination Office (receiving branch).";
        cancel submit;
    }
}

// 3. Mandatory Hardware Selection Check
is_empty_devices = false;
if(input.Devices == null)
{
    is_empty_devices = true;
}
else if(input.Devices.isEmpty())
{
    is_empty_devices = true;
}
else if(input.Devices.size() == 0)
{
    is_empty_devices = true;
}

if(is_empty_devices)
{
    alert "Inventory Validation Error:\n\nPlease select at least one device to initiate this transfer.";
    cancel submit;
}

// 4. Ensure Transfer Status is set and valid
if(input.Transfer_Status == null || input.Transfer_Status == "")
{
    input.Transfer_Status = "In-Transit";
}
else if(input.Transfer_Status != "In-Transit" && input.Transfer_Status != "In-Office" && input.Transfer_Status != "With-Customer")
{
    alert "Validation Error:\n\nInvalid Transfer Status. Please select 'In-Transit', 'In-Office', or 'With-Customer'.";
    cancel submit;
}

// 5. Cross-Check Status Parity with Transfer Type
if(input.Transfer_Status == "In-Office" && input.Transfer_Type == "Office to Customer")
{
    alert "Status Conflict:\n\nAn 'Office to Customer' transfer cannot have status 'In-Office'. Please select 'In-Transit' or 'With-Customer'.";
    cancel submit;
}
if(input.Transfer_Status == "With-Customer" && (input.Transfer_Type == "Inter Branch" || input.Transfer_Type == "Customer to Office"))
{
    alert "Status Conflict:\n\nA transfer heading to an office cannot have status 'With-Customer'. Please select 'In-Transit' or 'In-Office'.";
    cancel submit;
}

// 6. Clinical Safety Guard: Devices dispatched to customers must be in 'Ready Condition'
if(input.Transfer_Type == "Office to Customer" && input.Devices != null)
{
    for each dev_id in input.Devices
    {
        dev_rec = Devices[ID == dev_id];
        if(dev_rec.count() > 0)
        {
            d_stage = ifnull(dev_rec.Device_Stage, "");
            if(!d_stage.contains("Ready Condition"))
            {
                alert "Clinical Safety Guard:\n\nDevice '" + dev_rec.Serial_Number + "' cannot be dispatched to a customer because it is in stage '" + d_stage + "'.\n\nOnly devices certified in 'Ready Condition' can be delivered to customer facilities.";
                cancel submit;
            }
        }
    }
}
