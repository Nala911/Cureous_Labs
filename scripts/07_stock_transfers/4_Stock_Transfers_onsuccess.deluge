// ==============================================================================
// Module Name  : Stock Transfers (Form Link Name: Stock_Transfers)
// Script Type  : Form Workflow (On Success)
// Trigger Hook : Created or Edited -> Form Actions -> On Success
// File Path    : scripts/07_stock_transfers/4_Stock_Transfers_onsuccess.deluge
// Fields Used  : [Devices, Transfer_Status, Transfer_Type, Destination_Office, Destination_Customer]
// Cross-Forms  : [Devices]
// Purpose      : Synchronizes physical hardware custody, branch office, and rental
//                state in Devices directly from the multi-select Devices lookup across
//                all transfer lifecycle stages (Dispatched, In-Transit, Delivered).
// Optimization : Lean single-form architecture. Zero child audit table queries or inserts.
// ==============================================================================

if(input.Devices != null)
{
    for each dev_ref in input.Devices
    {
        dev = null;
        dev_id = dev_ref.toLong();
        if(dev_id != null && dev_id > 0)
        {
            dev = Devices[ID == dev_id];
        }
        else
        {
            dev_str = dev_ref.toString();
            dev = Devices[Serial_Number == dev_str];
        }
        
        if(dev != null)
        {
            // 1. Relational Custody: Link device to this Stock_Transfers record
            dev.Current_Custody = input.ID;
            
            // 2. Synchronize physical office and client context based on Transfer_Status
            if(input.Transfer_Status == "In-Transit")
            {
                dev.Current_Office = null;
                dev.Current_Customer = null;
                dev.Rental_State = "Inactive";
            }
            else if(input.Transfer_Status == "In-Office")
            {
                dev.Current_Office = input.Destination_Office;
                dev.Current_Customer = null;
                dev.Rental_State = "Inactive";
            }
            else if(input.Transfer_Status == "With-Customer")
            {
                dev.Current_Customer = input.Destination_Customer;
                dev.Current_Office = null;
                dev.Rental_State = "Inactive";
            }
        }
    }
}
