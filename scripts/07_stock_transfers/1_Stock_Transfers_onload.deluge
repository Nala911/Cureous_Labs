// ==============================================================================
// Module Name  : Stock Transfers (Form Link Name: Stock_Transfers)
// Script Type  : Form Workflow (On Load)
// Trigger Hook : Created or Edited -> Form Actions -> On Load
// File Path    : scripts/07_stock_transfers/1_Stock_Transfers_onload.deluge
// Fields Used  : [Transfer_Type, Transfer_Date, Source_Office, Source_Customer, Destination_Office, Destination_Customer, Select_Devices, Transfer_Status]
// Cross-Forms  : None
// Purpose      : Intelligent Progressive Disclosure UX:
//                In Add mode, Transfer Type, Transfer Date, and Transfer Status are user entry fields.
//                Transfer Status is enabled for user input and defaults to "Dispatched".
//                (Note: Stock_Transfer_ID is an Auto-Number field, so Zoho Creator
//                automatically hides it on Add mode and locks it in Edit mode).
//                Directional routing fields (Source/Destination Office/Customer) and hardware
//                selection lookup are hidden until triggered by user input of Transfer Type.
//                In Edit mode, routing parameters are locked and Transfer Status remains enabled.
// Optimization : Zero database queries consumed. Runs in <5ms.
// ==============================================================================

if(input.ID == null)
{
    // 1. ADD Mode: User Entry Starting Fields
    enable Transfer_Type;
    show Transfer_Type;
    
    input.Transfer_Date = zoho.currentdate;
    enable Transfer_Date;
    show Transfer_Date;
    
    // 2. Status Field: Enabled for user entry; defaults to "Dispatched"
    // User can change to "In-Transit" or "Delivered" during creation
    show Transfer_Status;
    enable Transfer_Status;
    input.Transfer_Status = "Dispatched";
    
    // 3. Directional lookups hidden and disabled until Transfer Type is selected
    hide Source_Office;
    hide Source_Customer;
    hide Destination_Office;
    hide Destination_Customer;
    
    disable Source_Office;
    disable Source_Customer;
    disable Destination_Office;
    disable Destination_Customer;
    
    // 4. Hardware selection lookup hidden and disabled until Source is chosen
    hide Select_Devices;
    disable Select_Devices;
}
else
{
    // 5. EDIT Mode: Maintain Data Integrity
    // Routing parameters and device selections cannot be altered once record is created
    disable Transfer_Type;
    disable Transfer_Date;
    disable Source_Office;
    disable Source_Customer;
    disable Destination_Office;
    disable Destination_Customer;
    disable Select_Devices;
    
    // Display and allow updating Transfer Status (for dispatchers / delivery staff)
    show Transfer_Status;
    enable Transfer_Status;
}
