// ==============================================================================
// Module Name  : Stock Transfers (Form Link Name: Stock_Transfers)
// Script Type  : Form Workflow (On User Input)
// Trigger Hook : Form Actions -> On User Input -> Field: Source_Customer
// File Path    : scripts/07_stock_transfers/2_3_Stock_Transfers_onuserinput_sourcecustomer.deluge
// Fields Used  : [Source_Customer, Select_Devices]
// Cross-Forms  : [Devices]
// Purpose      : 1. Dynamically queries and populates all Devices (both Control
//                   Units and Overlays) currently deployed or held with the selected
//                   Source Customer, displaying their Serial Numbers directly.
//                2. Activates hardware selection lookup for return to warehouse.
//                3. Resets hardware selection on customer change.
// Optimization : 1 targeted indexed query to fetch device serial numbers. Runs in <15ms.
// ==============================================================================

// 1. Reset device selection on Customer change
input.Select_Devices = null;

if(input.Source_Customer != null)
{
    s_cust = input.Source_Customer;
    
    // 2. Reveal and activate hardware selection lookup
    show Select_Devices;
    enable Select_Devices;
    
    // Explicitly clear lookup choices prior to adding filtered records
    clear input.Select_Devices;
    
    // 3. Query and populate all devices currently held/deployed at this customer by Serial Number
    cust_devices = Devices[Current_Customer == s_cust].Serial_Number.getAll();
    input.Select_Devices:ui.add(cust_devices);
    
    if(cust_devices.size() == 0)
    {
        alert "Notice: No devices are currently recorded as active or held with the selected customer.";
    }
}
else
{
    // If Source Customer is cleared: Lock and clear selection field
    clear input.Select_Devices;
    
    hide Select_Devices;
    disable Select_Devices;
}
