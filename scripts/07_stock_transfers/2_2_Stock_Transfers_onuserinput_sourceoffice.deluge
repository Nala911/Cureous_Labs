// ==============================================================================
// Module Name  : Stock Transfers (Form Link Name: Stock_Transfers)
// Script Type  : Form Workflow (On User Input)
// Trigger Hook : Form Actions -> On User Input -> Field: Source_Office
// File Path    : scripts/07_stock_transfers/2_2_Stock_Transfers_onuserinput_sourceoffice.deluge
// Fields Used  : [Transfer_Type, Source_Office, Destination_Office, Devices]
// Cross-Forms  : [Offices, Devices]
// Purpose      : 1. Filters Destination Office choices for 'Inter Branch' transfers to
//                   exclude the selected Source Office (preventing duplicate routing).
//                2. Enforces Clinical Safety Guard for 'Office to Customer' transfers:
//                   only populates units in 'Ready Condition'.
//                3. Dynamically queries and populates all available Devices (both Control
//                   Units and Overlays) physically located at the selected Source Office.
//                4. Resets hardware selection on source change.
// Optimization : 1 targeted indexed query to fetch available device records. Runs in <15ms.
// ==============================================================================

// 1. Reset device selection on Source change
input.Devices = null;

if(input.Source_Office != null)
{
    s_office = input.Source_Office;
    
    // 2. Inter Branch Routing: Filter Destination Office choices to exclude selected Source Office
    if(input.Transfer_Type == "Inter Branch")
    {
        available_destinations = Offices[ID != s_office].ID.getAll();
        clear Destination_Office;
        Destination_Office:ui.add(available_destinations);
        
        // If Destination Office was already set to the newly chosen Source Office, clear it
        if(input.Destination_Office == s_office)
        {
            input.Destination_Office = null;
        }
    }
    
    // 3. Reveal and activate hardware selection lookup
    show Devices;
    enable Devices;
    
    // Explicitly clear lookup choices prior to adding filtered records
    clear Devices;
    
    // 4. Query available devices at this Source Office
    avail_recs = Devices[Current_Office == s_office && Current_Customer == null && (Rental_State == "Inactive" || Rental_State == null || Rental_State == "")];
    
    available_devices = list();
    if(input.Transfer_Type == "Office to Customer")
    {
        // Clinical Safety Guard: For customer deliveries, only permit devices in 'Ready Condition'
        for each dev in avail_recs
        {
            d_stage = ifnull(dev.Device_Stage, "");
            if(d_stage.contains("Ready Condition"))
            {
                available_devices.add(dev.ID);
            }
        }
        
        if(available_devices.size() == 0)
        {
            alert "Clinical Safety Notice:\n\nNo 'Ready Condition' devices are available at the selected office for customer dispatch.\n\nAll units delivered to healthcare facilities must hold a certified 'Ready Condition' stage.";
        }
    }
    else
    {
        // For Inter Branch transfers: all warehouse devices are eligible (e.g. shipping units to HQ for maintenance/repair)
        available_devices = avail_recs.ID.getAll();
        if(available_devices.size() == 0)
        {
            alert "Notice: No available devices are currently in stock at the selected office.";
        }
    }
    
    Devices:ui.add(available_devices);
}
else
{
    // If Source Office is cleared: Lock and clear selection field
    clear Devices;
    
    hide Devices;
    disable Devices;
    
    // Reset Destination Office options to all offices for Inter Branch
    if(input.Transfer_Type == "Inter Branch")
    {
        all_destinations = Offices[ID != null].ID.getAll();
        clear Destination_Office;
        Destination_Office:ui.add(all_destinations);
    }
}
