// ==============================================================================
// Module Name  : Stock Transfers (Form Link Name: Stock_Transfers)
// Script Type  : Form Workflow (On User Input)
// Trigger Hook : Form Actions -> On User Input -> Field: Source_Office
// File Path    : scripts/07_stock_transfers/2_2_Stock_Transfers_onuserinput_sourceoffice.deluge
// Fields Used  : [Transfer_Type, Source_Office, Destination_Office, Select_Devices]
// Cross-Forms  : [Locations, Devices]
// Purpose      : 1. Filters Destination Office choices for 'Inter Branch' transfers to
//                   exclude the selected Source Office (preventing duplicate routing).
//                2. Dynamically queries and populates all available Devices (both Control
//                   Units and Overlays) physically located at the selected Source Office,
//                   displaying their Serial Numbers directly in a single lookup.
//                3. Resets hardware selection on source change.
// Optimization : 1 targeted indexed query to fetch available device serial numbers. Runs in <15ms.
// ==============================================================================

// 1. Reset device selection on Source change
input.Select_Devices = null;

if(input.Source_Office != null)
{
    s_office = input.Source_Office;
    
    // 2. Inter Branch Routing: Filter Destination Office choices to exclude selected Source Office
    if(input.Transfer_Type == "Inter Branch")
    {
        available_destinations = Locations[ID != s_office].ID.getAll();
        input.Destination_Office:ui.add(available_destinations);
        
        // If Destination Office was already set to the newly chosen Source Office, clear it
        if(input.Destination_Office == s_office)
        {
            input.Destination_Office = null;
        }
    }
    
    // 3. Reveal and activate hardware selection lookup
    show Select_Devices;
    enable Select_Devices;
    
    // Explicitly clear lookup choices prior to adding filtered records
    clear input.Select_Devices;
    
    // 4. Query and populate all available devices at this Source Office by Serial Number
    available_devices = Devices[Current_Location == s_office && (Current_Custody == "Internal Office" || Current_Custody == null || Current_Custody == "") && (Rental_State == "Inactive" || Rental_State == null || Rental_State == "")].Serial_Number.getAll();
    input.Select_Devices:ui.add(available_devices);
    
    // Friendly user feedback if the selected office has no available inventory
    if(available_devices.size() == 0)
    {
        alert "Notice: No available devices are currently in stock at the selected location.";
    }
}
else
{
    // If Source Office is cleared: Lock and clear selection field
    clear input.Select_Devices;
    
    hide Select_Devices;
    disable Select_Devices;
    
    // Reset Destination Office options to all locations for Inter Branch
    if(input.Transfer_Type == "Inter Branch")
    {
        all_destinations = Locations[ID != null].ID.getAll();
        input.Destination_Office:ui.add(all_destinations);
    }
}
