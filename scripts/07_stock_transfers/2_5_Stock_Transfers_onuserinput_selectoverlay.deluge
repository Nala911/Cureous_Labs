/* ==============================================================================
   Module Name  : Stock Transfers (Form Link Name: Stock_Transfers)
   Script Type  : Form Workflow (On User Input)
   Trigger Hook : Form Actions -> On User Input -> Field: Select_Overlay
   File Path    : scripts/07_stock_transfers/2_5_Stock_Transfers_onuserinput_selectoverlay.deluge
   Purpose      : Dynamically updates the Overlay count whenever items are selected
                  or deselected from the multi-select lookup.
   Optimization : Zero database queries consumed.
============================================================================== */

if(input.Select_Overlay != null)
{
    input.Overlay_Number = input.Select_Overlay.size();
}
else
{
    input.Overlay_Number = 0;
}
