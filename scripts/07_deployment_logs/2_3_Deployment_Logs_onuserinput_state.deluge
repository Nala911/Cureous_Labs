// ==============================================================================
// Module Name  : Deployment Logs (Form Link Name: Deployment_Logs)
// Script Type  : Form Workflow (On User Input)
// Trigger Hook : Created or Edited -> Field Actions -> State -> On User Input
// File Path    : scripts/07_deployment_logs/2_3_Deployment_Logs_onuserinput_state.deluge
// Fields Used  : [State, End_Date]
// Cross-Forms  : []
// Purpose      : Manages End_Date when deployment State changes. If user selects
//                "Returned", auto-populates End_Date with today's date if empty.
//                If switched back to an active state, clears the auto-set End_Date.
// Optimization : Pure UI event. Zero database queries.
// ==============================================================================

if(input.State == "Returned")
{
    // Auto-populate End Date with today's date on return if not already filled
    if(input.End_Date == null)
    {
        input.End_Date = zoho.currentdate;
    }
}
else
{
    // If switching back from Returned to active state, clear auto-populated date
    if(input.End_Date != null && input.End_Date == zoho.currentdate)
    {
        input.End_Date = null;
    }
}
