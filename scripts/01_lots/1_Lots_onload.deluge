// ==============================================================================
// Module Name  : Lots (Form Link Name: Lots)
// Script Type  : Form Workflow (On Load)
// Trigger Hook : Created or Edited -> Form Actions -> On Load
// File Path    : scripts/01_lots/1_Lots_onload.deluge
// Fields Used  : [Lot_ID]
// Cross-Forms  : None
// Purpose      : In Add mode: Enables Lot_ID as the single user entry field.
//                In Edit mode: Locks Lot_ID to preserve batch identity integrity.
// Optimization : Zero database queries. Runs in <5ms.
// ==============================================================================

if(input.ID == null)
{
    // 1. ADD Mode: 'Lot ID' is the only field for user entry
    enable Lot_ID;
    show Lot_ID;
}
else
{
    // 2. EDIT Mode: Protect Lot_ID once created
    disable Lot_ID;
    show Lot_ID;
}
