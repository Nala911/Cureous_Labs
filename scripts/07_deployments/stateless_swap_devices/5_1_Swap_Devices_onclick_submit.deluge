// ==============================================================================
// Module Name  : Swap Devices (Form Link Name: Swap_Devices)
// Script Type  : Stateless Form Action (On Click of Submit)
// Trigger Hook : Form Actions -> Submit Button -> On Click
// File Path    : scripts/07_deployments/stateless_swap_devices/5_1_Swap_Devices_onclick_submit.deluge
// Fields Used  : [Deployment, Control_Unit, Overlay, Swap_Date, Collected, Return_Office, Condition]
// Cross-Forms  : [Deployments, Devices]
// Purpose      : Validates swap inputs and replacement readiness, closes the old
//                deployment at Swap_Date, inserts a replacement deployment
//                inheriting Customer and Deployment_State, updates swapped-out
//                assets with Device_Stage = Condition (and Available in Stock
//                at Return_Office when Collected? is checked, or Idle with
//                Customer retaining Current_Customer when unchecked), and sets
//                new/retained assets active at the customer.
// Optimization : Uses batch queries ([ID in out_ids] and [ID in active_ids]) to
//                avoid loop queries and minimize statement consumption.
// ==============================================================================

// 1. Mandatory Input Validation
is_valid = true;

if(input.Deployment == null)
{
    alert "Please select an active deployment to swap.";
    is_valid = false;
}
else if(input.Control_Unit == null && input.Overlay == null)
{
    alert "Please keep or select at least one device (Control Unit or Overlay) for the new deployment.";
    is_valid = false;
}
else if(input.Swap_Date == null)
{
    alert "Swap Date is mandatory.";
    is_valid = false;
}
else if(input.Condition == null || input.Condition == "")
{
    alert "Condition is mandatory for swapped-out device tracking.";
    is_valid = false;
}
else if(input.Collected == true && input.Return_Office == null)
{
    alert "Please select the Return Office since Collected? is checked.";
    is_valid = false;
}

if(is_valid)
{
    // 2. Fetch Source Deployment & Validate State / Dates / Changes
    target_dep_id = input.Deployment;
    old_dep = Deployments[ID == target_dep_id];
    
    if(old_dep == null)
    {
        alert "Selected deployment record was not found.";
    }
    else if(old_dep.Deployment_State == "Closed")
    {
        alert "Swap Blocked: Selected deployment is already Closed.";
    }
    else if(old_dep.Start_Date != null && input.Swap_Date < old_dep.Start_Date)
    {
        alert "Invalid Swap Date: Swap Date cannot be earlier than the deployment Start Date (" + old_dep.Start_Date + ").";
    }
    else
    {
        old_cu = old_dep.Control_Unit;
        old_ov = old_dep.Overlay;
        old_cust = old_dep.Customer;
        old_state = old_dep.Deployment_State;
        new_cu = input.Control_Unit;
        new_ov = input.Overlay;
        swap_dt = input.Swap_Date;
        
        if(new_cu == old_cu && new_ov == old_ov)
        {
            alert "No Changes Detected: Please change or remove at least one device (Control Unit or Overlay) to perform a swap.";
        }
        else
        {
            // 3. Replacement Readiness & Double-Booking Guard
            replacement_ok = true;
            
            if(new_cu != null && new_cu != old_cu)
            {
                cu_dev = Devices[ID == new_cu];
                if(cu_dev == null)
                {
                    alert "Selected replacement Control Unit was not found.";
                    replacement_ok = false;
                }
                else if(cu_dev.Device_Type != "Control Unit")
                {
                    alert "Invalid Component: " + cu_dev.Serial_Number + " is not a Control Unit.";
                    replacement_ok = false;
                }
                else if(cu_dev.Device_Stage != "6 - Ready Condition")
                {
                    alert "Swap Blocked: Control Unit " + cu_dev.Serial_Number + " is at stage '" + cu_dev.Device_Stage + "' (requires '6 - Ready Condition').";
                    replacement_ok = false;
                }
                else if(cu_dev.Device_State != "Available in Stock")
                {
                    alert "Swap Blocked: Control Unit " + cu_dev.Serial_Number + " has state '" + cu_dev.Device_State + "' (requires 'Available in Stock').";
                    replacement_ok = false;
                }
                else
                {
                    cu_conflicts = Deployments[ID != target_dep_id && Control_Unit == new_cu && Deployment_State != "Closed"];
                    if(cu_conflicts.count() > 0)
                    {
                        alert "Conflict Detected: Control Unit " + cu_dev.Serial_Number + " is already deployed in another active deployment.";
                        replacement_ok = false;
                    }
                }
            }
            
            if(replacement_ok && new_ov != null && new_ov != old_ov)
            {
                ov_dev = Devices[ID == new_ov];
                if(ov_dev == null)
                {
                    alert "Selected replacement Overlay was not found.";
                    replacement_ok = false;
                }
                else if(ov_dev.Device_Type != "Overlay")
                {
                    alert "Invalid Component: " + ov_dev.Serial_Number + " is not an Overlay.";
                    replacement_ok = false;
                }
                else if(ov_dev.Device_Stage != "6 - Ready Condition")
                {
                    alert "Swap Blocked: Overlay " + ov_dev.Serial_Number + " is at stage '" + ov_dev.Device_Stage + "' (requires '6 - Ready Condition').";
                    replacement_ok = false;
                }
                else if(ov_dev.Device_State != "Available in Stock")
                {
                    alert "Swap Blocked: Overlay " + ov_dev.Serial_Number + " has state '" + ov_dev.Device_State + "' (requires 'Available in Stock').";
                    replacement_ok = false;
                }
                else
                {
                    ov_conflicts = Deployments[ID != target_dep_id && Overlay == new_ov && Deployment_State != "Closed"];
                    if(ov_conflicts.count() > 0)
                    {
                        alert "Conflict Detected: Overlay " + ov_dev.Serial_Number + " is already deployed in another active deployment.";
                        replacement_ok = false;
                    }
                }
            }
            
            if(replacement_ok)
            {
                // 4. Close Old Deployment & Insert New Deployment
                old_dep.Deployment_State = "Closed";
                old_dep.End_Date = swap_dt;
                
                insert into Deployments
                [
                    Customer = old_cust
                    Control_Unit = new_cu
                    Overlay = new_ov
                    Start_Date = swap_dt
                    Deployment_State = old_state
                ]
                
                // 5. Batch-Update Swapped-Out Devices
                out_ids = list();
                if(old_cu != null && old_cu != new_cu)
                {
                    out_ids.add(old_cu);
                }
                if(old_ov != null && old_ov != new_ov && !out_ids.contains(old_ov))
                {
                    out_ids.add(old_ov);
                }
                
                if(out_ids.size() > 0)
                {
                    swapped_out_devs = Devices[ID in out_ids];
                    is_collected = (input.Collected == true);
                    target_office = input.Return_Office;
                    target_condition = input.Condition;
                    
                    for each dev in swapped_out_devs
                    {
                        dev.Device_Stage = target_condition;
                        if(is_collected)
                        {
                            dev.Device_State = "Available in Stock";
                            dev.Current_Customer = null;
                            dev.Current_Office = target_office;
                        }
                        else
                        {
                            dev.Device_State = "Idle with Customer";
                            dev.Current_Office = null;
                        }
                    }
                }
                
                // 6. Batch-Update New & Retained Active Devices
                target_active_state = "Rentally Active";
                if(old_state == "Demo")
                {
                    target_active_state = "Active in Demo";
                }
                else if(old_state == "Idle")
                {
                    target_active_state = "Idle with Customer";
                }
                
                active_ids = list();
                if(new_cu != null)
                {
                    active_ids.add(new_cu);
                }
                if(new_ov != null && !active_ids.contains(new_ov))
                {
                    active_ids.add(new_ov);
                }
                
                if(active_ids.size() > 0)
                {
                    active_devs = Devices[ID in active_ids];
                    for each dev in active_devs
                    {
                        dev.Device_State = target_active_state;
                        dev.Current_Customer = old_cust;
                        dev.Current_Office = null;
                    }
                }
                
                // 7. Confirmation & Report Refresh
                alert "Device swap completed successfully.";
                openUrl("#Report:All_Deployments", "same window");
            }
        }
    }
}
