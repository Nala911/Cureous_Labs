// ==============================================================================
// Module Name  : Swap Devices (Form Link Name: Swap_Devices)
// Script Type  : Stateless Form Action (On Click of Submit)
// Trigger Hook : Form Actions -> Submit Button -> On Click
// File Path    : scripts/07_deployments/stateless_swap_devices/5_1_Swap_Devices_onclick_submit.deluge
// Fields Used  : [Deployment, Control_Unit, Overlay, Swap_Date, Collected,
//                 Return_Office, Device_Condition]
// Cross-Forms  : [Deployments, Devices, Customers]
// Purpose      : Thin UI wrapper calling handle_swap_devices with try-catch
//                error protection. Alerts only on error; redirects silently
//                to All_Deployments on success.
// Optimization : Delegates batch processing to standalone function.
// ==============================================================================

is_col = (input.Collected == true);
err = thisapp.handle_swap_devices(input.Deployment, input.Control_Unit, input.Overlay, input.Swap_Date, is_col, input.Return_Office, input.Device_Condition);
if(err != "")
{
    alert err;
}
else
{
    openUrl("#Report:All_Deployments", "same window");
}
