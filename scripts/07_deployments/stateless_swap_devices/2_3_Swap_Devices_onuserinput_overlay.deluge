// ==============================================================================
// Module Name  : Swap Devices (Form Link Name: Swap_Devices)
// Script Type  : Stateless Form Workflow (On User Input)
// Trigger Hook : Field Actions -> Overlay -> On User Input
// File Path    : scripts/07_deployments/stateless_swap_devices/2_3_Swap_Devices_onuserinput_overlay.deluge
// Fields Used  : [Deployment, Control_Unit, Overlay, Collected, Return_Office, Device_Condition]
// Cross-Forms  : [Deployments, Devices]
// Purpose      : Validates replacement Overlay readiness ("6 - Ready Condition",
//                "Available in Stock", no active deployment conflict) and
//                dynamically reveals Collected? & Device_Condition only when an
//                existing Control Unit or Overlay is being replaced/removed.
// Optimization : Targeted PK lookups only. Runs in <15ms.
// ==============================================================================

src_dep = null;
src_cu = null;
src_ov = null;
curr_dep_id = 0;

if(input.Deployment != null)
{
    curr_dep_id = input.Deployment;
    src_dep = Deployments[ID == curr_dep_id];
    if(src_dep != null)
    {
        src_cu = src_dep.Control_Unit;
        src_ov = src_dep.Overlay;
    }
}

if(input.Overlay != null)
{
    target_ov_id = input.Overlay;
    ov_dev = Devices[ID == target_ov_id];
    
    if(ov_dev != null)
    {
        if(ov_dev.Device_Type != "Overlay")
        {
            alert "Invalid Selection: The selected asset (" + ov_dev.Serial_Number + ") is a Control Unit, not an Overlay.";
            input.Overlay = src_ov;
        }
        else if(src_ov != target_ov_id)
        {
            if(ov_dev.Device_Stage != "6 - Ready Condition")
            {
                alert "Not Ready for Swap: Overlay " + ov_dev.Serial_Number + " is at stage '" + ov_dev.Device_Stage + "' (requires '6 - Ready Condition').";
                input.Overlay = src_ov;
            }
            else if(ov_dev.Device_State != "Available in Stock" && ov_dev.Device_State != "Idle with Customer")
            {
                alert "Device Unavailable: Overlay " + ov_dev.Serial_Number + " is currently '" + ov_dev.Device_State + "' (requires 'Available in Stock' or 'Idle with Customer').";
                input.Overlay = src_ov;
            }
            else if(ov_dev.Device_State == "Idle with Customer" && src_dep != null && ov_dev.Current_Customer != null && ov_dev.Current_Customer != src_dep.Customer)
            {
                alert "Custody Mismatch: Overlay " + ov_dev.Serial_Number + " is currently 'Idle with Customer' at a different customer site.";
                input.Overlay = src_ov;
            }
            else
            {
                open_ov_logs = Deployments[ID != curr_dep_id && Overlay == target_ov_id && Deployment_State != "Closed"];
                if(open_ov_logs.count() > 0)
                {
                    alert "Conflict Detected: Overlay " + ov_dev.Serial_Number + " is already deployed in another active deployment.";
                    input.Overlay = src_ov;
                }
            }
        }
    }
}

// Smart UX: Show Collected? & Device_Condition only if an existing unit is being swapped out
has_swap_out = false;
if(src_dep != null)
{
    if((src_cu != null && input.Control_Unit != src_cu) || (src_ov != null && input.Overlay != src_ov))
    {
        has_swap_out = true;
    }
}

if(has_swap_out)
{
    show Collected;
    enable Collected;
    show Device_Condition;
    enable Device_Condition;
    if(input.Device_Condition == null || input.Device_Condition == "")
    {
        input.Device_Condition = "Disinfection Needed";
    }
    if(input.Collected == true)
    {
        show Return_Office;
        enable Return_Office;
    }
    else
    {
        hide Return_Office;
    }
}
else
{
    input.Collected = false;
    input.Return_Office = null;
    hide Collected;
    hide Return_Office;
    hide Device_Condition;
}
