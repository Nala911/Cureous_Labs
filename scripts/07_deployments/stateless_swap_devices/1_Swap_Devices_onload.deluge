// ==============================================================================
// Module Name  : Swap Devices (Form Link Name: Swap_Devices)
// Script Type  : Stateless Form Workflow (On Load)
// Trigger Hook : Form Actions -> On Load
// File Path    : scripts/07_deployments/stateless_swap_devices/1_Swap_Devices_onload.deluge
// Fields Used  : [Deployment, Control_Unit, Overlay, Swap_Date, Collected, Return_Office, Device_Condition]
// Cross-Forms  : [Deployments, Devices]
// Purpose      : Initializes Swap_Devices modal via Deluge: filters Deployment
//                lookup to active records, defaults Swap_Date to today, hides
//                Collected/Return_Office/Device_Condition until a swap-out
//                change occurs, disables CU/Overlay if no Deployment is chosen,
//                and filters CU/Overlay to [current unit] + [Ready & In Stock].
// Optimization : Three indexed list queries and one optional PK lookup. Runs <15ms.
// ==============================================================================

// 1. Dynamically filter Deployment lookup to active (non-closed) deployments
pre_dep_id = input.Deployment;
active_dep_ids = Deployments[Deployment_State != "Closed"].ID.getAll();

clear Deployment;
if(active_dep_ids.size() > 0)
{
    Deployment:ui.add(active_dep_ids);
}

// 2. Fetch ready replacement candidates for Control Unit & Overlay
ready_cu_ids = Devices[Device_Type == "Control Unit" && Device_Stage == "6 - Ready Condition" && Device_State == "Available in Stock"].ID.getAll();
ready_ov_ids = Devices[Device_Type == "Overlay" && Device_Stage == "6 - Ready Condition" && Device_State == "Available in Stock"].ID.getAll();

// 3. Default Swap_Date and initialize smart return-tracking fields as hidden
if(input.Swap_Date == null)
{
    input.Swap_Date = zoho.currentdate;
}

input.Collected = false;
input.Return_Office = null;
input.Device_Condition = "Disinfection Needed";
hide Collected;
hide Return_Office;
hide Device_Condition;

// 4. Populate Deployment units & filtered lookup options, or lock until selected
if(pre_dep_id != null)
{
    dep = Deployments[ID == pre_dep_id];
    if(dep == null || dep.Deployment_State == "Closed")
    {
        alert "Swap Blocked: The selected deployment is closed or no longer exists.";
        input.Deployment = null;
        input.Control_Unit = null;
        input.Overlay = null;
        clear Control_Unit;
        clear Overlay;
        if(ready_cu_ids.size() > 0)
        {
            Control_Unit:ui.add(ready_cu_ids);
        }
        if(ready_ov_ids.size() > 0)
        {
            Overlay:ui.add(ready_ov_ids);
        }
        disable Control_Unit;
        disable Overlay;
    }
    else
    {
        input.Deployment = pre_dep_id;
        
        cu_choices = list();
        if(dep.Control_Unit != null)
        {
            cu_choices.add(dep.Control_Unit);
        }
        for each rcu in ready_cu_ids
        {
            if(!cu_choices.contains(rcu))
            {
                cu_choices.add(rcu);
            }
        }
        clear Control_Unit;
        if(cu_choices.size() > 0)
        {
            Control_Unit:ui.add(cu_choices);
        }
        
        ov_choices = list();
        if(dep.Overlay != null)
        {
            ov_choices.add(dep.Overlay);
        }
        for each rov in ready_ov_ids
        {
            if(!ov_choices.contains(rov))
            {
                ov_choices.add(rov);
            }
        }
        clear Overlay;
        if(ov_choices.size() > 0)
        {
            Overlay:ui.add(ov_choices);
        }
        
        enable Control_Unit;
        enable Overlay;
        input.Control_Unit = dep.Control_Unit;
        input.Overlay = dep.Overlay;
    }
}
else
{
    input.Control_Unit = null;
    input.Overlay = null;
    clear Control_Unit;
    clear Overlay;
    if(ready_cu_ids.size() > 0)
    {
        Control_Unit:ui.add(ready_cu_ids);
    }
    if(ready_ov_ids.size() > 0)
    {
        Overlay:ui.add(ready_ov_ids);
    }
    disable Control_Unit;
    disable Overlay;
}
