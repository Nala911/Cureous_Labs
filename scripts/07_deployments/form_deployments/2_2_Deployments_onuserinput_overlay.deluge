// ==============================================================================
// Module Name  : Deployments (Form Link Name: Deployments)
// Script Type  : Form Workflow (On User Input)
// Trigger Hook : Created or Edited -> Field Actions -> Overlay -> On User Input
// File Path    : scripts/07_deployments/form_deployments/2_2_Deployments_onuserinput_overlay.deluge
// Fields Used  : [Overlay]
// Cross-Forms  : [Devices]
// Purpose      : Validates selected hardware is an Overlay mattress. In Add mode,
//                verifies the mattress is in "6 - Ready Condition" and "Available in Stock".
//                Alerts and clears field if mismatched or ineligible.
// Optimization : Single indexed PK lookup by ID. Executes in <10ms.
// ==============================================================================

if(input.Overlay != null)
{
    // Pre-assign variable for Criteria Bracket Integrity (Law 1)
    target_ov_id = input.Overlay;
    ov_dev = Devices[ID == target_ov_id];
    
    if(ov_dev != null)
    {
        // 1. Verify hardware classification
        if(ov_dev.Device_Type != "Overlay")
        {
            alert "Invalid Selection: The selected asset (" + ov_dev.Serial_Number + ") is a Control Unit, not an Overlay. Please select a valid Overlay mattress.";
            input.Overlay = null;
        }
        else
        {
            // 2. In Add mode, enforce readiness & availability gate
            if(input.ID == null)
            {
                if(ov_dev.Device_Stage != "6 - Ready Condition")
                {
                    alert "Not Ready for Deployment: Overlay " + ov_dev.Serial_Number + " is currently at stage '" + ov_dev.Device_Stage + "' (requires '6 - Ready Condition').";
                    input.Overlay = null;
                }
                else if(ov_dev.Device_State != "Available in Stock")
                {
                    alert "Device Unavailable: Overlay " + ov_dev.Serial_Number + " is currently '" + ov_dev.Device_State + "' (requires 'Available in Stock').";
                    input.Overlay = null;
                }
            }
        }
    }
}
