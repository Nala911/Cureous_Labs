// ==============================================================================
// Module Name  : Deployments (Form Link Name: Deployments)
// Script Type  : Form Workflow (On User Input)
// Trigger Hook : Created or Edited -> Field Actions -> Control_Unit -> On User Input
// File Path    : scripts/07_deployments/form_deployments/2_1_Deployments_onuserinput_control_unit.deluge
// Fields Used  : [Control_Unit]
// Cross-Forms  : [Devices]
// Purpose      : Validates selected hardware is a Control Unit pump. In Add mode,
//                verifies the pump is in "6 - Ready Condition" and "Available in Stock".
//                Alerts and clears field if mismatched or ineligible.
// Optimization : Single indexed PK lookup by ID. Executes in <10ms.
// ==============================================================================

if(input.Control_Unit != null)
{
    // Pre-assign variable for Criteria Bracket Integrity (Law 1)
    target_cu_id = input.Control_Unit;
    cu_dev = Devices[ID == target_cu_id];
    
    if(cu_dev != null)
    {
        // 1. Verify hardware classification
        if(cu_dev.Device_Type != "Control Unit")
        {
            alert "Invalid Selection: The selected asset (" + cu_dev.Serial_Number + ") is an Overlay, not a Control Unit. Please select a valid Control Unit.";
            input.Control_Unit = null;
        }
        else
        {
            // 2. In Add mode, enforce readiness & availability gate
            if(input.ID == null)
            {
                if(cu_dev.Device_Stage != "6 - Ready Condition")
                {
                    alert "Not Ready for Deployment: Control Unit " + cu_dev.Serial_Number + " is currently at stage '" + cu_dev.Device_Stage + "' (requires '6 - Ready Condition').";
                    input.Control_Unit = null;
                }
                else if(cu_dev.Device_State != "Available in Stock")
                {
                    alert "Device Unavailable: Control Unit " + cu_dev.Serial_Number + " is currently '" + cu_dev.Device_State + "' (requires 'Available in Stock').";
                    input.Control_Unit = null;
                }
            }
        }
    }
}
