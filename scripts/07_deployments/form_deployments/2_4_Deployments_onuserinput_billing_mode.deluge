// ==============================================================================
// Module Name  : Deployments (Form Link Name: Deployments)
// Script Type  : Form Workflow (On User Input)
// Trigger Hook : Created or Edited -> Field Actions -> Billing_Mode -> On User Input
// File Path    : scripts/07_deployments/form_deployments/2_4_Deployments_onuserinput_billing_mode.deluge
// Fields Used  : [Billing_Mode, Deployment_State, Start_Date, Rental_Rate, GST_Amount,
//                 Invoice_Amount, Billing_Day, Next_Billing_From, Next_Billing_To,
//                 Next_Billing_Period, Last_Billed_Period]
// Cross-Forms  : None
// Purpose      : Shows Fixed Monthly rate fields when Fixed Monthly is selected,
//                clears/hides them for Pay Per Use, and calculates the initial
//                Next_Billing_Period preview from Start_Date.
// Optimization : Zero database queries. Runs in <2ms.
// ==============================================================================

if(input.Billing_Mode == "Fixed Monthly")
{
    show Rental_Rate;
    enable Rental_Rate;
    show GST_Amount;
    show Invoice_Amount;
    
    if(input.Rental_Rate != null)
    {
        gst_val = (input.Rental_Rate * 0.05).round(2);
        input.GST_Amount = gst_val;
        input.Invoice_Amount = input.Rental_Rate + gst_val;
    }
}
else
{
    hide Rental_Rate;
    hide GST_Amount;
    hide Invoice_Amount;
    input.Rental_Rate = null;
    input.GST_Amount = null;
    input.Invoice_Amount = null;
}

has_billed = (input.Last_Billed_Period != null && input.Last_Billed_Period != "");
if(input.Deployment_State == "Rental" && !has_billed)
{
    if(input.Start_Date != null && input.Billing_Mode != null && input.Billing_Mode != "")
    {
        anchor_day = input.Start_Date.getDay();
        cycle = thisapp.compute_billing_period(input.Start_Date, input.Billing_Mode, anchor_day);
        if(cycle.containKey("_error"))
        {
            alert cycle.get("_error");
        }
        else if(cycle.containKey("label"))
        {
            input.Billing_Day = anchor_day;
            input.Next_Billing_From = cycle.get("from");
            input.Next_Billing_To = cycle.get("to");
            input.Next_Billing_Period = cycle.get("label");
        }
    }
    else
    {
        input.Billing_Day = null;
        input.Next_Billing_From = null;
        input.Next_Billing_To = null;
        input.Next_Billing_Period = null;
    }
}
