// ==============================================================================
// Module Name  : Deployments (Form Link Name: Deployments)
// Script Type  : Form Workflow (On User Input)
// Trigger Hook : Created or Edited -> Field Actions -> Deployment_State -> On User Input
// File Path    : scripts/07_deployments/form_deployments/2_3_Deployments_onuserinput_deployment_state.deluge
// Fields Used  : [Deployment_State, End_Date]
// Cross-Forms  : None
// Purpose      : Defensive UI handler for Deployment_State transitions: reveals
//                and auto-populates End_Date if Closed is present, and hides/clears
//                auto-set End_Date for active states (Rental, Demo, Idle).
// Optimization : Zero database queries. Runs in <1ms.
// ==============================================================================

if(input.Deployment_State == "Closed")
{
    show End_Date;
    enable End_Date;
    if(input.End_Date == null)
    {
        input.End_Date = zoho.currentdate;
    }
}
else
{
    hide End_Date;
    if(input.ID == null || input.End_Date == zoho.currentdate)
    {
        input.End_Date = null;
    }
}
