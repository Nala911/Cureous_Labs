// ==============================================================================
// Module Name  : Deployments (Form Link Name: Deployments)
// Script Type  : Form Workflow (On Success)
// Trigger Hook : Created or Edited -> Form Actions -> On Success
// File Path    : scripts/07_deployments/form_deployments/4_Deployments_onsuccess.deluge
// Fields Used  : [Deployment_State, Customer, Control_Unit, Overlay, Return_Report]
// Cross-Forms  : [Devices]
// Purpose      : Synchronizes physical asset master records in Devices via
//                sync_deployment_devices (try-catch protected), alerts only on
//                error, and returns cleanly to All_Devices or All_Deployments.
// Optimization : Delegates updates to standalone function.
// ==============================================================================

err = thisapp.sync_deployment_devices(input.Deployment_State, input.Customer, input.Control_Unit, input.Overlay);
if(err != "")
{
    alert err;
}

if(input.Return_Report == "All_Devices")
{
    openUrl("#Report:All_Devices", "parent window");
}
else
{
    openUrl("#Report:All_Deployments", "same window");
}
