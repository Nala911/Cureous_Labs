// ==============================================================================
// Module Name  : Deployments (Report Link Name: All_Deployments)
// Script Type  : Report Custom Action Function (Namespace: deployments_actions)
// Trigger Hook : Report Actions -> For Multiple Records -> Close Deployments
// File Path    : scripts/07_deployments/report_all_deployments/5_1_All_Deployments_customaction_open_close_deployments.deluge
// Fields Used  : [ID]
// Cross-Forms  : [Close_Deployments]
// Purpose      : Captures selected record IDs from All_Deployments report and
//                launches the Close_Deployments stateless form modal with the
//                Deployments multi-select lookup pre-filled.
// Optimization : Single client-side redirect. Zero statement/query cost.
// ==============================================================================

void open_close_deployments(Deployments selected_deployments)
{
    // 1. Extract all selected record IDs into a list
    id_list = selected_deployments.ID.getAll();
    
    // 2. Open the stateless form in a popup modal with deployments pre-filled
    openUrl("#Form:Close_Deployments?Deployments=" + id_list, "popup window", "height=600px,width=700px");
}
