// ==============================================================================
// Module Name  : Mark Deployments Billed (Form Link Name: Mark_Deployments_Billed)
// Script Type  : Stateless Form Workflow (On Load)
// Trigger Hook : Form Actions -> On Load
// File Path    : scripts/07_deployments/stateless_mark_billed/1_Mark_Deployments_Billed_onload.deluge
// Fields Used  : [Deployments, Billing_Action]
// Cross-Forms  : [Deployments]
// Purpose      : Dynamically filters Deployments lookup to records with a pending
//                billing period (Next_Billing_From != null) while preserving valid
//                URL pre-fills, and defaults Billing_Action to Invoice Created.
// Optimization : Single indexed list query on Deployments. Runs in <10ms.
// ==============================================================================

// 1. Filter Deployments multi-select lookup to records with a pending billing period
pre_selected = input.Deployments;
pending_dep_ids = Deployments[Next_Billing_From != null].ID.getAll();

clear Deployments;
if(pending_dep_ids.size() > 0)
{
    Deployments:ui.add(pending_dep_ids);
}
else
{
    alert "No deployments currently have a pending billing period.";
}

if(pre_selected != null && !pre_selected.isEmpty())
{
    kept_ids = list();
    skipped_count = 0;
    for each dep_id in pre_selected
    {
        if(pending_dep_ids.contains(dep_id))
        {
            kept_ids.add(dep_id);
        }
        else
        {
            skipped_count = skipped_count + 1;
        }
    }
    input.Deployments = kept_ids;
    if(skipped_count > 0)
    {
        alert "Excluded " + skipped_count + " deployment(s) with no pending billing period.";
    }
}

// 2. Default Billing_Action to Invoice Created
if(input.Billing_Action == null || input.Billing_Action == "")
{
    input.Billing_Action = "Invoice Created";
}
