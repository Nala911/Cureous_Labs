// ==============================================================================
// Module Name  : Close Deployments (Form Link Name: Close_Deployments)
// Script Type  : Stateless Form Action (On Click of Submit)
// Trigger Hook : Form Actions -> Submit Button -> On Click
// File Path    : scripts/07_deployments/stateless_close_deployments/5_1_Close_Deployments_onclick_submit.deluge
// Fields Used  : [Deployments, End_Date, Collected, Return_Office, Device_Condition]
// Cross-Forms  : [Deployments, Devices]
// Purpose      : Thin UI wrapper calling handle_close_deployments with
//                try-catch error protection. Alerts only on error; redirects
//                silently to All_Deployments on success.
// Optimization : Delegates batch processing to standalone function.
// ==============================================================================

is_col = (input.Collected == true);
err = thisapp.handle_close_deployments(input.Deployments, input.End_Date, is_col, input.Return_Office, input.Device_Condition);
if(err != "")
{
    alert err;
}
else
{
    openUrl("#Report:All_Deployments", "same window");
}
