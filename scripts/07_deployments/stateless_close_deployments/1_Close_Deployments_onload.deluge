// ==============================================================================
// Module Name  : Close Deployments (Form Link Name: Close_Deployments)
// Script Type  : Stateless Form Workflow (On Load)
// Trigger Hook : Form Actions -> On Load
// File Path    : scripts/07_deployments/stateless_close_deployments/1_Close_Deployments_onload.deluge
// Fields Used  : [Deployments, End_Date, Collected, Return_Office, Device_Condition]
// Cross-Forms  : [Deployments]
// Purpose      : Dynamically filters Deployments lookup via Deluge to active
//                records (Deployment_State != "Closed") while preserving valid
//                URL pre-fills, defaults End_Date and Device_Condition, and hides
//                Return_Office unless Collected? is checked.
// Optimization : Single indexed list query on Deployments. Runs in <10ms.
// ==============================================================================

// 1. Filter Deployments multi-select lookup via Deluge to active records only
pre_selected = input.Deployments;
active_dep_ids = Deployments[Deployment_State != "Closed"].ID.getAll();

clear Deployments;
if(active_dep_ids.size() > 0)
{
    Deployments:ui.add(active_dep_ids);
}

if(pre_selected != null && !pre_selected.isEmpty())
{
    kept_ids = list();
    closed_skipped = 0;
    for each dep_id in pre_selected
    {
        if(active_dep_ids.contains(dep_id))
        {
            kept_ids.add(dep_id);
        }
        else
        {
            closed_skipped = closed_skipped + 1;
        }
    }
    input.Deployments = kept_ids;
    if(closed_skipped > 0)
    {
        alert "Excluded " + closed_skipped + " already-Closed deployment(s) from the close selection.";
    }
}

// 2. Default End_Date to today if empty
if(input.End_Date == null)
{
    input.End_Date = zoho.currentdate;
}

// 3. Keep Device_Condition always visible and defaulted to Disinfection Needed
show Device_Condition;
enable Device_Condition;
if(input.Device_Condition == null || input.Device_Condition == "")
{
    input.Device_Condition = "Disinfection Needed";
}

// 4. Hide Return_Office unless Collected? is already checked
if(input.Collected == true)
{
    show Return_Office;
    enable Return_Office;
}
else
{
    hide Return_Office;
}
