/* ==============================================================================
   Module Name  : Product Catalog (Form Link Name: Product_Catalog)
   Script Type  : Form Workflow (On Validate)
   Trigger Hook : Created or Edited -> Form Actions -> On Validate
   File Path    : scripts/04_product_catalog/3_Product_Catalog_onvalidate.deluge
   Purpose      : Validates mandatory selection and ID linkage, and prevents
                  duplicate registration with a friendly user alert.
   Optimization : Max 1 indexed query for duplicate check. Runs in <10ms.
============================================================================== */

// 1. Mandatory Field Checks
if(input.Item_Name == null || input.Item_Name.trim() == "")
{
    alert "Item Name is mandatory. Please select an active rental item from the dropdown.";
    cancel submit;
}

if(input.Item_ID == null || input.Item_ID.trim() == "")
{
    alert "Item ID is missing: Unable to retrieve Zoho Books Item ID.\n\nPlease re-select the item from the dropdown.";
    cancel submit;
}

// 2. Friendly Duplicate Guard
if(input.ID == null)
{
    existing_items = Product_Catalog[Item_ID == input.Item_ID || Item_Name == input.Item_Name];
    if(existing_items.count() > 0)
    {
        alert "Item Already Onboarded:\n\n'" + input.Item_Name + "' is already registered in Cureous PRS with Item ID " + input.Item_ID + ".\n\nDuplicate registration is prevented. You can view or use this product from the 'All Product Catalogs' report.";
        cancel submit;
    }
}
else
{
    existing_items = Product_Catalog[(Item_ID == input.Item_ID || Item_Name == input.Item_Name) && ID != input.ID];
    if(existing_items.count() > 0)
    {
        alert "Item Already Onboarded:\n\nAnother item with Name '" + input.Item_Name + "' or ID " + input.Item_ID + " already exists.";
        cancel submit;
    }
}

// 3. Safety Fallback for Derived Fields
name_lower = input.Item_Name.toLowerCase();

if(input.Billing_Unit == null || input.Billing_Unit.trim() == "")
{
    if(name_lower.contains("monthly"))
    {
        input.Billing_Unit = "Month";
    }
    else
    {
        input.Billing_Unit = "Day";
    }
}

if(input.Product_Model == null || input.Product_Model.trim() == "")
{
    if(name_lower.contains("eturnal home"))
    {
        input.Product_Model = "Eturnal Home";
    }
    else if(name_lower.contains("eturnal hospital"))
    {
        input.Product_Model = "Eturnal Hospital";
    }
    else if(name_lower.contains("eturnal one with foam"))
    {
        input.Product_Model = "Eturnal One with Foam";
    }
    else if(name_lower.contains("eturnal one"))
    {
        input.Product_Model = "Eturnal One";
    }
    else if(name_lower.contains("altern4"))
    {
        input.Product_Model = "Altern4";
    }
    else if(name_lower.contains("altern"))
    {
        input.Product_Model = "Altern";
    }
    else
    {
        clean_model = input.Item_Name.replaceAll("Rental", "").replaceAll("rental", "");
        clean_model = clean_model.replaceAll("Daily", "").replaceAll("daily", "");
        clean_model = clean_model.replaceAll("Monthly", "").replaceAll("monthly", "");
        clean_model = clean_model.replaceAll("™", "").replaceAll("®", "").replaceAll("-", "").trim();
        input.Product_Model = clean_model;
    }
}
