/* ==============================================================================
   Module Name  : Product Catalog (Form Link Name: Product_Catalog)
   Script Type  : Form Workflow (On Load)
   Trigger Hook : Created or Edited -> Form Actions -> On Load
   File Path    : scripts/04_product_catalog/1_Product_Catalog_onload.deluge
   Purpose      : Locks derived fields. In Edit mode, prevents altering existing
                  products. In Add mode, fetches active rental service items from
                  Zoho Books and populates the Item Name dropdown dynamically.
   Optimization : Native Zoho Books integration call. Filters out existing records.
============================================================================== */

// 1. Lock all auto-derived fields
disable Item_ID;
disable Product_Model;
disable Billing_Unit;

// 2. Edit Mode Protection: Disallow altering existing product record
if(input.ID != null)
{
    disable Item_Name;
}
else
{
    // 3. In Add mode: Fetch active rental items from Zoho Books via native integration
    org_id = "";
    org_resp = zoho.books.getOrganizations();
    if(org_resp.get("code") == 0)
    {
        org_list = org_resp.get("organizations");
        if(org_list.size() > 0)
        {
            org_id = org_list.get(0).get("organization_id").toString();
        }
    }
    
    // Fallback: If you prefer to set your Organization ID directly, uncomment below:
    // org_id = "YOUR_ORGANIZATION_ID";
    
    if(org_id != "")
    {
        query_params = "filter_by=Status.Active&per_page=200";
        books_resp = zoho.books.getRecords("items", org_id, query_params);
        
        if(books_resp.get("code") == 0 && books_resp.get("items") != null)
        {
            books_items = books_resp.get("items");
            
            // Collect items already onboarded in Creator to avoid duplicates
            existing_items = Product_Catalog[ID != null].Item_Name.getAll();
            
            item_names = List();
            for each itm in books_items
            {
                itm_name = itm.get("name");
                itm_status = itm.get("status");
                
                // Only include active items starting with "Rental" (case-insensitive) not already added in Creator
                if(itm_name != null && itm_name != "" && itm_status == "active")
                {
                    if(itm_name.trim().toLowerCase().startsWith("rental") && !existing_items.contains(itm_name))
                    {
                        item_names.add(itm_name);
                    }
                }
            }
            item_names.sort();
            
            // Populate dropdown choices
            clear Item_Name;
            input.Item_Name:ui.add(item_names);
        }
    }
}
