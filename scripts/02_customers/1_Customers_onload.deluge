/* ==============================================================================
   Module Name  : Customers (Form Link Name: Customers)
   Script Type  : Form Workflow (On Load)
   Trigger Hook : Created or Edited -> Form Actions -> On Load
   File Path    : scripts/02_customers/1_Customers_onload.deluge
   Fields Used  : [Customer_Name, Customer_ID, Customer_Type, Billing_Address, Customer_Status, Active_Control_Unit_Count, Active_Overlay_Count, Active_Bed_Stations_Count, Spare_Units_Count]
   Cross-Forms  : None (Integrates with Zoho Books API)
   Purpose      : Intelligent Form UX: In Add mode, Customer Name is the user entry
                   field. Customer ID, Customer Type, and Billing Address are disabled
                   to provide visual context without user editing. Customer Status and
                   all equipment rollup metrics are completely hidden during creation
                   (used solely for reports). Fetches active Books contacts to populate
                   Customer Name choices. In Edit mode, locks customer identity.
   Optimization : Native Zoho Books integration call. Minimal statement footprint.
============================================================================== */

// 1. Context Fields: Disabled so user sees auto-populated Books profile data without editing
disable Customer_ID;
disable Customer_Type;
disable Billing_Address;

if(input.ID == null)
{
    // 2. ADD Mode: Hide metric and status fields (they make no sense on new intake; for reports only)
    hide Customer_Status;
    hide Active_Control_Unit_Count;
    hide Active_Overlay_Count;
    hide Active_Bed_Stations_Count;
    hide Spare_Units_Count;
    
    // Ensure context fields are visible
    show Customer_ID;
    show Customer_Type;
    show Billing_Address;
    
    // Customer Name is the primary user entry field
    enable Customer_Name;
    show Customer_Name;
    
    // 3. Fetch active customers from Zoho Books via native integration
    try 
    {
        org_id = "";
        org_resp = zoho.books.getOrganizations();
        if(org_resp.get("code") == 0)
        {
            org_list = org_resp.get("organizations");
            if(org_list.size() > 0)
            {
                org_id = org_list.get(0).get("organization_id").toString();
            }
        }
        
        // Fallback: If you prefer to set your Organization ID directly, uncomment below:
        // org_id = "YOUR_ORGANIZATION_ID";
        
        if(org_id != "")
        {
            query_params = "filter_by=Status.ActiveCustomers&per_page=200";
            books_resp = zoho.books.getRecords("contacts", org_id, query_params);
            
            if(books_resp.get("code") == 0)
            {
                books_contacts = books_resp.get("contacts");
                
                // Collect customer names already onboarded in Creator to avoid duplicates
                existing_customers = Customers[ID != null].Customer_Name.getAll();
                
                customer_names = List();
                for each contact in books_contacts
                {
                    c_name = contact.get("contact_name");
                    if(c_name != null && c_name != "" && !existing_customers.contains(c_name))
                    {
                        customer_names.add(c_name);
                    }
                }
                customer_names.sort();
                
                // Populate dropdown choices
                clear input.Customer_Name;
                input.Customer_Name:ui.add(customer_names);
            }
        }
    }
    catch (e)
    {
        // Graceful catch to ensure form still renders cleanly if Books API experiences network delay
    }
}
else
{
    // 4. EDIT Mode: Customer record is immutable once created
    disable Customer_Name;
    
    disable Customer_Status;
    disable Active_Control_Unit_Count;
    disable Active_Overlay_Count;
    disable Active_Bed_Stations_Count;
    disable Spare_Units_Count;
    
    show Customer_Status;
    show Active_Control_Unit_Count;
    show Active_Overlay_Count;
    show Active_Bed_Stations_Count;
    show Spare_Units_Count;
}
