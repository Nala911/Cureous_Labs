/* ==============================================================================
   Module Name  : Bed Stations (Form Link Name: Bed_Stations)
   Script Type  : Field Workflow (On User Input)
   Trigger Hook : Field Actions -> Deployment_Status -> On User Input
   File Path    : scripts/08_bed_stations/2_3_Bed_Stations_onuserinput_deploymentstatus.deluge
   Fields Used  : [Deployment_Status, Deployment_End_Date]
   Cross-Forms  : None
   Purpose      : When Deployment Status is transitioned to "Closed", automatically
                  sets Deployment End Date to the current timestamp. Clears End Date
                  if reverted to Active or Inactive.
   Optimization : Zero database queries consumed.
============================================================================== */

if(input.Deployment_Status == "Closed")
{
    // Auto-populate closure timestamp into disabled context field
    if(input.Deployment_End_Date == null)
    {
        input.Deployment_End_Date = zoho.currenttime;
    }
}
else
{
    // Station is Active or Inactive; clear End Date
    input.Deployment_End_Date = null;
}
