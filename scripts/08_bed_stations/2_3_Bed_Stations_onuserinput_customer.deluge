// ==============================================================================
// Module Name  : Bed Stations (Form Link Name: Bed_Stations)
// Script Type  : Form Workflow (On User Input)
// Trigger Hook : Created or Edited -> Field Actions -> Customer -> On User Input
// File Path    : scripts/08_bed_stations/2_3_Bed_Stations_onuserinput_customer.deluge
// Fields Used  : [Deployment_Type, Customer, Bed_Station_Title, Control_Unit, Overlay_Asset]
// Cross-Forms  : [Customers, Devices, Bed_Stations]
// Purpose      : Triggered when Customer is chosen directly (specifically in "For Trial"
//                mode):
//                1. Resolves Customer Name and pre-fills Bed Station Title if empty.
//                2. Smart Hardware Filtering: Dynamically queries Devices physically
//                   present at customer site and EXCLUDES devices already actively
//                   deployed on other patient beds.
//                3. Populates Control Unit and Overlay dropdowns with available hardware.
//                4. Activates hardware lookups and notifies user if inventory is empty.
// Optimization : Targeted indexed queries outside criteria brackets. Law 1 compliant.
// ==============================================================================

if(input.Customer != null)
{
    cust_id = input.Customer;
    cust_rec = Customers[ID == cust_id];
    cust_name = "";
    clean_cust = "";
    if(cust_rec.count() > 0)
    {
        cust_raw = ifnull(cust_rec.Customer_Name, "");
        cust_name = cust_raw;
        
        clean_cust = cust_raw;
        clean_cust = clean_cust.replaceAll(" Private Limited", "");
        clean_cust = clean_cust.replaceAll(" Pvt Ltd", "");
        clean_cust = clean_cust.replaceAll(" Pvt. Ltd.", "");
        clean_cust = clean_cust.replaceAll(" Pvt. Ltd", "");
        clean_cust = clean_cust.replaceAll(" Limited", "");
        clean_cust = clean_cust.replaceAll(" Ltd.", "");
        clean_cust = clean_cust.replaceAll(" Ltd", "");
        clean_cust = clean_cust.replaceAll(" & Research Centre", "");
        clean_cust = clean_cust.replaceAll(" and Research Centre", "");
        clean_cust = clean_cust.replaceAll(" & Research Center", "");
        clean_cust = clean_cust.replaceAll(" and Research Center", "");
        clean_cust = clean_cust.replaceAll(" Multispeciality Hospital", " Hospital");
        clean_cust = clean_cust.replaceAll(" Multispecialty Hospital", " Hospital");
        clean_cust = clean_cust.replaceAll(" Super Speciality Hospital", " Hospital");
        clean_cust = clean_cust.replaceAll(" Superspeciality Hospital", " Hospital");
        clean_cust = clean_cust.replaceAll(" Multispeciality", "");
        clean_cust = clean_cust.replaceAll(" Multispecialty", "");
        clean_cust = clean_cust.replaceAll(" Superspeciality", "");
        clean_cust = clean_cust.replaceAll(" Super Speciality", "");
        clean_cust = clean_cust.trim();
        
        if(clean_cust.length() > 30)
        {
            c_words = clean_cust.toList(" ");
            if(c_words.size() > 3)
            {
                clean_cust = c_words.get(0) + " " + c_words.get(1) + " " + c_words.get(2);
            }
        }
    }
    
    // 1. Pre-fill Bed Station Title if empty (Clean Customer - Bed)
    if(input.Bed_Station_Title == null || input.Bed_Station_Title.trim() == "")
    {
        if(clean_cust != "")
        {
            input.Bed_Station_Title = clean_cust + " - Bed";
        }
    }
    
    // 2. Smart Customer Hardware Retrieval
    curr_bed_id = 0;
    if(input.ID != null)
    {
        curr_bed_id = input.ID;
    }
    
    // Collect IDs of hardware already actively deployed on other stations at this facility
    active_cu_ids = Bed_Stations[Customer == cust_id && Deployment_Status == "Active" && ID != curr_bed_id].Control_Unit.getAll();
    active_ov_ids = Bed_Stations[Customer == cust_id && Deployment_Status == "Active" && ID != curr_bed_id].Overlay_Asset.getAll();
    
    // Fetch all hardware physically at this customer's site
    all_cu_recs = Devices[Current_Customer == cust_id && Device_Type == "Control Unit"];
    all_ov_recs = Devices[Current_Customer == cust_id && Device_Type == "Overlay"];
    
    // Filter strictly available units
    avail_cu_ids = list();
    for each cu in all_cu_recs
    {
        if(!active_cu_ids.contains(cu.ID))
        {
            avail_cu_ids.add(cu.ID);
        }
    }
    
    avail_ov_ids = list();
    for each ov in all_ov_recs
    {
        if(!active_ov_ids.contains(ov.ID))
        {
            avail_ov_ids.add(ov.ID);
        }
    }
    
    // 3. Clear existing selections and assign filtered choices
    input.Control_Unit = null;
    input.Overlay_Asset = null;
    input.Control_Unit:ui.add(avail_cu_ids);
    input.Overlay_Asset:ui.add(avail_ov_ids);
    
    // 4. Enable hardware lookups
    enable Control_Unit;
    enable Overlay_Asset;
    
    // 5. Inventory check notice
    if(avail_cu_ids.size() == 0 || avail_ov_ids.size() == 0)
    {
        alert "Inventory Notice:\n\nCustomer '" + cust_name + "' has " + avail_cu_ids.size() + " available Control Unit(s) and " + avail_ov_ids.size() + " available Overlay(s) at their site.\n\nPlease verify that a Stock Transfer ('Office to Customer') has been completed to deliver spare devices to this customer.";
    }
}
else
{
    // Customer cleared: Reset hardware selections and lock
    input.Control_Unit = null;
    input.Overlay_Asset = null;
    disable Control_Unit;
    disable Overlay_Asset;
}
