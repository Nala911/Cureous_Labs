// ==============================================================================
// Module Name  : Bed Stations (Form Link Name: Bed_Stations)
// Script Type  : Form Workflow (On Success)
// Trigger Hook : Created or Edited -> Form Actions -> On Success
// File Path    : scripts/08_bed_stations/4_Bed_Stations_onsuccess.deluge
// Fields Used  : [Deployment_Type, Rental_Agreement, Control_Unit, Overlay_Asset, Deployment_Status, Customer, Deployment_Start_Date, Deployment_End_Date, Bed_Station_ID, Bed_Station_Title]
// Cross-Forms  : [Devices, Bed_Stations]
// Purpose      : Executes synchronized downstream updates on form submission:
//                1. Updates physical hardware custody and Rental State in Devices.
//                2. Reconciles bedside hardware swaps: marks newly coupled units Active
//                   and safely resets any replaced/unassigned buffer units to Inactive.
//                3. Appends system-generated Bed_Station_ID to Bed_Station_Title.
//                4. Navigates cleanly to the 'All_Bed_Stations' report view.
// Optimization : Atomic updates with targeted criteria outside brackets. Law 1 compliant.
// ==============================================================================

current_station_id = input.ID;

// 1. Synchronize Physical Hardware Custody in Devices Master
if(input.Control_Unit != null)
{
    cu_id = input.Control_Unit;
    cu_dev = Devices[ID == cu_id];
    if(cu_dev.count() > 0)
    {
        if(input.Deployment_Status == "Active")
        {
            cu_dev.Rental_State = "Active";
            cu_dev.Current_Customer = input.Customer;
        }
        else if(input.Deployment_Status == "Closed")
        {
            cu_dev.Rental_State = "Inactive";
        }
    }
}

if(input.Overlay_Asset != null)
{
    ov_id = input.Overlay_Asset;
    ov_dev = Devices[ID == ov_id];
    if(ov_dev.count() > 0)
    {
        if(input.Deployment_Status == "Active")
        {
            ov_dev.Rental_State = "Active";
            ov_dev.Current_Customer = input.Customer;
        }
        else if(input.Deployment_Status == "Closed")
        {
            ov_dev.Rental_State = "Inactive";
        }
    }
}

// 2. Hardware Swap Reconciliation (Self-Healing)
// If a device was swapped out during an edit, reset its Rental State to Inactive
if(input.Customer != null)
{
    cust_id = input.Customer;
    status_active = "Active";
    
    // Fetch all currently active devices at this customer facility
    cust_active_devices = Devices[Current_Customer == cust_id && Rental_State == status_active];
    
    // Fetch all hardware IDs actively assigned to ANY active bed station at this customer site
    active_station_cu_ids = Bed_Stations[Customer == cust_id && Deployment_Status == status_active].Control_Unit.getAll();
    active_station_ov_ids = Bed_Stations[Customer == cust_id && Deployment_Status == status_active].Overlay_Asset.getAll();
    
    // Reconcile: If a device is marked Active but no longer deployed on any active bed station, revert to Inactive
    for each d in cust_active_devices
    {
        d_id = d.ID;
        if(!active_station_cu_ids.contains(d_id) && !active_station_ov_ids.contains(d_id))
        {
            d.Rental_State = "Inactive";
        }
    }
}

// 3. Ensure Bed Station Title includes generated Bed Station ID (e.g. #BST-0001)
if(input.Bed_Station_ID != null)
{
    bst_rec = Bed_Stations[ID == current_station_id];
    if(bst_rec.count() > 0)
    {
        curr_title = ifnull(bst_rec.Bed_Station_Title, "");
        bst_id_str = input.Bed_Station_ID.toString();
        if(curr_title != "" && !curr_title.contains(bst_id_str))
        {
            bst_rec.Bed_Station_Title = curr_title + " #" + bst_id_str;
        }
    }
}

// 4. Redirect cleanly to the All_Bed_Stations report view
openUrl("#Report:All_Bed_Stations", "same window");
