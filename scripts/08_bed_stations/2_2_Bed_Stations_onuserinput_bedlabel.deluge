/* ==============================================================================
   Module Name  : Bed Stations (Form Link Name: Bed_Stations)
   Script Type  : Field Workflow (On User Input)
   Trigger Hook : Field Actions -> Bed_Label -> On User Input
   File Path    : scripts/08_bed_stations/2_2_Bed_Stations_onuserinput_bedlabel.deluge
   Fields Used  : [Bed_Label, Customer, Bed_Station_ID, Bed_Station_Title]
   Cross-Forms  : [Customers]
   Purpose      : When Bed Label is entered or modified (e.g. "ICU Bed 04"),
                  auto-fills the default Bed Station Title ([Customer] - [Bed Label] ([ID]))
                  while leaving it fully editable by the user.
   Optimization : Zero database queries when Customer lookup is already loaded.
============================================================================== */

if(input.Bed_Label != null && input.Bed_Label.trim() != "")
{
    cust_name = "";
    if(input.Customer != null)
    {
        cust_rec = Customers[ID == input.Customer];
        cust_name = ifnull(cust_rec.Customer_Name, "");
    }
    
    bst_id = ifnull(input.Bed_Station_ID, "");
    
    if(cust_name != "")
    {
        input.Bed_Station_Title = cust_name + " - " + input.Bed_Label.trim() + if(bst_id != "", " (" + bst_id + ")", "");
    }
    else
    {
        input.Bed_Station_Title = input.Bed_Label.trim() + if(bst_id != "", " (" + bst_id + ")", "");
    }
}
else
{
    // If Bed Label cleared, fallback to customer name and ID
    cust_name = "";
    if(input.Customer != null)
    {
        cust_rec = Customers[ID == input.Customer];
        cust_name = ifnull(cust_rec.Customer_Name, "");
    }
    
    bst_id = ifnull(input.Bed_Station_ID, "");
    if(cust_name != "")
    {
        input.Bed_Station_Title = cust_name + if(bst_id != "", " (" + bst_id + ")", "");
    }
    else
    {
        input.Bed_Station_Title = "";
    }
}
