// ==============================================================================
// Module Name  : Bed Stations (Form Link Name: Bed_Stations)
// Script Type  : Form Workflow (On User Input)
// Trigger Hook : Created or Edited -> Field Actions -> Rental_Agreement -> On User Input
// File Path    : scripts/08_bed_stations/2_2_Bed_Stations_onuserinput_rentalagreement.deluge
// Fields Used  : [Rental_Agreement, Customer, Bed_Station_Title, Control_Unit, Overlay_Asset]
// Cross-Forms  : [Rental_Agreements, Customers, Devices, Bed_Stations]
// Purpose      : When a Rental Agreement is selected:
//                1. Auto-populates Customer from agreement.
//                2. Pre-fills Bed Station Title with customer name if empty,
//                   allowing user customization (e.g. room/ward info).
//                3. Smart Hardware Filtering: Dynamically queries Devices physically
//                   present at customer site and EXCLUDES devices already actively
//                   deployed on other patient beds.
//                4. Validates Fixed Monthly 1-to-1 agreement limits with an advisory notice.
// Optimization : Targeted indexed queries outside criteria brackets. Law 1 compliant.
// ==============================================================================

if(input.Rental_Agreement != null)
{
    agr_id = input.Rental_Agreement;
    agr_rec = Rental_Agreements[ID == agr_id];
    
    if(agr_rec.count() > 0)
    {
        // 1. Auto-populate Customer lookup
        input.Customer = agr_rec.Customer;
        
        // 2. Extract First 3 Words of Customer Name
        clean_cust = "";
        cust_name = "";
        if(agr_rec.Customer != null)
        {
            cust_id = agr_rec.Customer;
            cust_rec = Customers[ID == cust_id];
            if(cust_rec.count() > 0)
            {
                cust_raw = ifnull(cust_rec.Customer_Name, "").trim();
                cust_name = cust_raw;
                
                c_words = cust_raw.toList(" ");
                if(c_words.size() > 3)
                {
                    clean_cust = c_words.get(0) + " " + c_words.get(1) + " " + c_words.get(2);
                }
                else
                {
                    clean_cust = cust_raw;
                }
            }
        }
        
        // 3. Pre-fill Bed Station Title if empty (First 3 words + #[Count+1], editable by staff)
        if(input.Bed_Station_Title == null || input.Bed_Station_Title.trim() == "")
        {
            if(clean_cust != "")
            {
                c_target_id = input.Customer;
                curr_bed_id = 0;
                if(input.ID != null)
                {
                    curr_bed_id = input.ID;
                }
                existing_beds = Bed_Stations[Customer == c_target_id && ID != curr_bed_id];
                next_bed_num = existing_beds.count() + 1;
                
                input.Bed_Station_Title = clean_cust + " #" + next_bed_num;
            }
        }
        
        // 4. Smart Customer Hardware Retrieval
        // Query devices at customer site that are NOT deployed in an Active Bed Station
        if(input.Customer != null)
        {
            c_target = input.Customer;
            status_active = "Active";
            curr_id = 0;
            if(input.ID != null)
            {
                curr_id = input.ID;
            }
            
            // Collect hardware IDs already deployed on OTHER active bed stations at this facility
            active_cu_ids = Bed_Stations[Customer == c_target && Deployment_Status == status_active && ID != curr_id].Control_Unit.getAll();
            active_ov_ids = Bed_Stations[Customer == c_target && Deployment_Status == status_active && ID != curr_id].Overlay_Asset.getAll();
            
            // Fetch all hardware physically present at customer facility
            cu_type = "Control Unit";
            ov_type = "Overlay";
            all_cu_recs = Devices[Current_Customer == c_target && Device_Type == cu_type];
            all_ov_recs = Devices[Current_Customer == c_target && Device_Type == ov_type];
            
            ready_cu_stage = "6 - CU Ready Condition";
            ready_ov_stage = "6 - OV Ready Condition";
            
            // Filter strictly available units in Ready Condition (exclude active units and defective units)
            avail_cu_ids = list();
            for each cu in all_cu_recs
            {
                if(!active_cu_ids.contains(cu.ID) && cu.Device_Stage == ready_cu_stage)
                {
                    avail_cu_ids.add(cu.ID);
                }
            }
            
            avail_ov_ids = list();
            for each ov in all_ov_recs
            {
                if(!active_ov_ids.contains(ov.ID) && ov.Device_Stage == ready_ov_stage)
                {
                    avail_ov_ids.add(ov.ID);
                }
            }
            
            // Clear current selections and populate choices
            input.Control_Unit = null;
            input.Overlay_Asset = null;
            input.Control_Unit:ui.add(avail_cu_ids);
            input.Overlay_Asset:ui.add(avail_ov_ids);
            
            // Enable hardware fields for selection
            enable Control_Unit;
            enable Overlay_Asset;
            
            // If customer has no available hardware, display notice
            if(avail_cu_ids.size() == 0 || avail_ov_ids.size() == 0)
            {
                alert "Inventory Notice:\n\nCustomer '" + cust_name + "' currently has " + avail_cu_ids.size() + " available Control Unit(s) and " + avail_ov_ids.size() + " available Overlay(s) at their site.\n\nPlease verify that a Stock Transfer ('Office to Customer') has been dispatched and received at this hospital.";
            }
        }
        
        // 5. Fixed Monthly Agreement Active Station Check (Advisory Notice)
        if(agr_rec.Rental_Item != null)
        {
            r_item_id = agr_rec.Rental_Item;
            r_item = Rental_Items[ID == r_item_id];
            if(r_item != null && r_item.Billing_Unit == "Month")
            {
                curr_id = 0;
                if(input.ID != null)
                {
                    curr_id = input.ID;
                }
                status_active = "Active";
                existing_active = Bed_Stations[Rental_Agreement == agr_id && Deployment_Status == status_active && ID != curr_id];
                if(existing_active.count() > 0)
                {
                    alert "Notice for Fixed Monthly Contract:\n\nAgreement '" + agr_rec.Agreement_Title + "' already has an Active Bed Station assigned:\n" + existing_active.Bed_Station_Title.getAll() + ".\n\nFixed Monthly agreements typically cover strictly 1 active station at a time. If you deploy a second station, please ensure a separate agreement is created or switch to a Daily agreement.";
                }
            }
        }
    }
}
else
{
    // Rental Agreement cleared: Clear dependent fields
    input.Customer = null;
    input.Control_Unit = null;
    input.Overlay_Asset = null;
    disable Control_Unit;
    disable Overlay_Asset;
}
