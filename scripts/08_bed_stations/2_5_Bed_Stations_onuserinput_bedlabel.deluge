// ==============================================================================
// Module Name  : Bed Stations (Form Link Name: Bed_Stations)
// Script Type  : Form Workflow (On User Input)
// Trigger Hook : Created or Edited -> Field Actions -> Bed_Label -> On User Input
// File Path    : scripts/08_bed_stations/2_5_Bed_Stations_onuserinput_bedlabel.deluge
// Fields Used  : [Bed_Label, Customer, Bed_Station_ID, Bed_Station_Title]
// Cross-Forms  : [Customers]
// Purpose      : When user enters or modifies Bed Label (e.g. "ICU Bed 04"),
//                dynamically composes Bed Station Title with format:
//                "[Customer Name] - [Bed Label]" (or appends ID if in Edit mode).
//                Retains user editability if custom adjustments are required.
// Optimization : Max 1 indexed query on Customers. Runs in <10ms.
// ==============================================================================

if(input.Bed_Label != null && input.Bed_Label.trim() != "")
{
    cust_name = "";
    if(input.Customer != null)
    {
        c_id = input.Customer;
        cust_rec = Customers[ID == c_id];
        if(cust_rec.count() > 0)
        {
            cust_name = ifnull(cust_rec.Customer_Name, "");
        }
    }
    
    // Resolve Bed Station ID suffix if existing record
    id_suffix = "";
    if(input.Bed_Station_ID != null)
    {
        id_suffix = " (" + input.Bed_Station_ID.toString() + ")";
    }
    
    if(cust_name != "")
    {
        input.Bed_Station_Title = cust_name + " - " + input.Bed_Label.trim() + id_suffix;
    }
    else
    {
        input.Bed_Station_Title = input.Bed_Label.trim() + id_suffix;
    }
}
