// ==============================================================================
// Module Name  : Bed Stations (Form Link Name: Bed_Stations)
// Script Type  : Form Workflow (On User Input)
// Trigger Hook : Created or Edited -> Field Actions -> Deployment_Status -> On User Input
// File Path    : scripts/08_bed_stations/2_6_Bed_Stations_onuserinput_deploymentstatus.deluge
// Fields Used  : [Deployment_Status, Deployment_End_Date]
// Cross-Forms  : None
// Purpose      : When Deployment Status is transitioned to "Closed", automatically
//                sets Deployment End Date to the current timestamp. Clears End Date
//                if reverted back to "Active" or "Inactive".
// Optimization : Zero database queries. Runs in <2ms.
// ==============================================================================

if(input.Deployment_Status == "Closed")
{
    input.Deployment_End_Date = zoho.currenttime;
}
else
{
    input.Deployment_End_Date = null;
}
