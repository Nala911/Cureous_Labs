// ==============================================================================
// Module Name  : Swap Devices (Action Handler Function)
// Script Type  : Standalone Deluge Function (Namespace: Default)
// Trigger Hook : Called by Swap_Devices -> Submit -> On Click
// File Path    : scripts/functions/handle_swap_devices.deluge
// Fields Used  : [Deployment, Control_Unit, Overlay, Swap_Date, Collected,
//                 Return_Office, Device_Condition]
// Cross-Forms  : [Deployments, Devices, Customers]
// Purpose      : Validates swap inputs, replacement readiness, and double-booking,
//                preserves billing continuity, closes old deployment, inserts
//                replacement deployment, and updates Devices inside try-catch.
// Optimization : Uses batch queries ([ID in out_ids] and [ID in active_ids]).
// ==============================================================================

string handle_swap_devices(int deployment_id, int new_cu, int new_ov, date swap_date, bool is_collected, int return_office, string device_condition)
{
    err_msg = "";
    try
    {
        if(deployment_id == null)
        {
            err_msg = "Please select an active deployment to swap.";
        }
        else if(new_cu == null && new_ov == null)
        {
            err_msg = "Please keep or select at least one device (Control Unit or Overlay) for the new deployment.";
        }
        else if(swap_date == null)
        {
            err_msg = "Swap Date is mandatory.";
        }
        else
        {
            old_dep = Deployments[ID == deployment_id];
            if(old_dep == null)
            {
                err_msg = "Selected deployment record was not found.";
            }
            else if(old_dep.Deployment_State == "Closed")
            {
                err_msg = "Swap Blocked: Selected deployment is already Closed.";
            }
            else if(old_dep.Start_Date != null && swap_date < old_dep.Start_Date)
            {
                err_msg = "Invalid Swap Date: Swap Date cannot be earlier than the deployment Start Date (" + old_dep.Start_Date + ").";
            }
            else
            {
                old_cu = old_dep.Control_Unit;
                old_ov = old_dep.Overlay;
                old_cust = old_dep.Customer;
                old_state = old_dep.Deployment_State;
                has_swap_out = (old_cu != null && new_cu != old_cu) || (old_ov != null && new_ov != old_ov);
                
                if(new_cu == old_cu && new_ov == old_ov)
                {
                    err_msg = "No Changes Detected: Please change, add, or remove at least one device (Control Unit or Overlay).";
                }
                else if(has_swap_out && (device_condition == null || device_condition == ""))
                {
                    err_msg = "Device Condition is mandatory for swapped-out device tracking.";
                }
                else if(has_swap_out && is_collected && return_office == null)
                {
                    err_msg = "Please select the Return Office since Collected? is checked.";
                }
                else
                {
                    replacement_ok = true;
                    
                    if(new_cu != null && new_cu != old_cu)
                    {
                        cu_dev = Devices[ID == new_cu];
                        if(cu_dev == null)
                        {
                            err_msg = "Selected replacement Control Unit was not found.";
                            replacement_ok = false;
                        }
                        else if(cu_dev.Device_Type != "Control Unit")
                        {
                            err_msg = "Invalid Component: " + cu_dev.Serial_Number + " is not a Control Unit.";
                            replacement_ok = false;
                        }
                        else if(cu_dev.Device_Stage != "6 - Ready Condition")
                        {
                            err_msg = "Swap Blocked: Control Unit " + cu_dev.Serial_Number + " is at stage '" + cu_dev.Device_Stage + "' (requires '6 - Ready Condition').";
                            replacement_ok = false;
                        }
                        else if(cu_dev.Device_State != "Available in Stock" && cu_dev.Device_State != "Idle with Customer")
                        {
                            err_msg = "Swap Blocked: Control Unit " + cu_dev.Serial_Number + " has state '" + cu_dev.Device_State + "' (requires 'Available in Stock' or 'Idle with Customer').";
                            replacement_ok = false;
                        }
                        else if(cu_dev.Device_State == "Idle with Customer" && cu_dev.Current_Customer != null && cu_dev.Current_Customer != old_cust)
                        {
                            err_msg = "Swap Blocked: Control Unit " + cu_dev.Serial_Number + " is 'Idle with Customer' at a different customer site.";
                            replacement_ok = false;
                        }
                        else
                        {
                            cu_conflicts = Deployments[ID != deployment_id && Control_Unit == new_cu && Deployment_State != "Closed"];
                            if(cu_conflicts.count() > 0)
                            {
                                err_msg = "Conflict Detected: Control Unit " + cu_dev.Serial_Number + " is already deployed in another active deployment.";
                                replacement_ok = false;
                            }
                        }
                    }
                    
                    if(replacement_ok && new_ov != null && new_ov != old_ov)
                    {
                        ov_dev = Devices[ID == new_ov];
                        if(ov_dev == null)
                        {
                            err_msg = "Selected replacement Overlay was not found.";
                            replacement_ok = false;
                        }
                        else if(ov_dev.Device_Type != "Overlay")
                        {
                            err_msg = "Invalid Component: " + ov_dev.Serial_Number + " is not an Overlay.";
                            replacement_ok = false;
                        }
                        else if(ov_dev.Device_Stage != "6 - Ready Condition")
                        {
                            err_msg = "Swap Blocked: Overlay " + ov_dev.Serial_Number + " is at stage '" + ov_dev.Device_Stage + "' (requires '6 - Ready Condition').";
                            replacement_ok = false;
                        }
                        else if(ov_dev.Device_State != "Available in Stock" && ov_dev.Device_State != "Idle with Customer")
                        {
                            err_msg = "Swap Blocked: Overlay " + ov_dev.Serial_Number + " has state '" + ov_dev.Device_State + "' (requires 'Available in Stock' or 'Idle with Customer').";
                            replacement_ok = false;
                        }
                        else if(ov_dev.Device_State == "Idle with Customer" && ov_dev.Current_Customer != null && ov_dev.Current_Customer != old_cust)
                        {
                            err_msg = "Swap Blocked: Overlay " + ov_dev.Serial_Number + " is 'Idle with Customer' at a different customer site.";
                            replacement_ok = false;
                        }
                        else
                        {
                            ov_conflicts = Deployments[ID != deployment_id && Overlay == new_ov && Deployment_State != "Closed"];
                            if(ov_conflicts.count() > 0)
                            {
                                err_msg = "Conflict Detected: Overlay " + ov_dev.Serial_Number + " is already deployed in another active deployment.";
                                replacement_ok = false;
                            }
                        }
                    }
                    
                    if(replacement_ok)
                    {
                        // Pre-compute Pay Per Use billing period before mutating records
                        old_billing_mode = old_dep.Billing_Mode;
                        old_rental_rate = old_dep.Rental_Rate;
                        old_gst = old_dep.GST_Amount;
                        old_inv_amt = old_dep.Invoice_Amount;
                        old_bill_day = old_dep.Billing_Day;
                        old_next_from = old_dep.Next_Billing_From;
                        old_next_to = old_dep.Next_Billing_To;
                        old_next_period = old_dep.Next_Billing_Period;
                        old_last_billed = old_dep.Last_Billed_Period;
                        
                        new_billing_mode = null;
                        new_rental_rate = null;
                        new_gst = null;
                        new_inv_amt = null;
                        new_bill_day = null;
                        new_next_from = null;
                        new_next_to = null;
                        new_next_period = null;
                        new_last_billed = null;
                        ppu_cycle = map();
                        
                        if(old_state == "Rental" && old_billing_mode == "Pay Per Use")
                        {
                            new_bill_day = swap_date.getDay();
                            ppu_cycle = thisapp.compute_billing_period(swap_date, "Pay Per Use", new_bill_day);
                            if(ppu_cycle.containKey("_error"))
                            {
                                err_msg = ppu_cycle.get("_error");
                            }
                        }
                        
                        if(err_msg == "")
                        {
                            cust_rec = Customers[ID == old_cust];
                            short_cust = "";
                            if(cust_rec != null && cust_rec.Customer_Name != null)
                            {
                                raw_words = cust_rec.Customer_Name.trim().toList(" ");
                                clean_words = list();
                                for each w in raw_words
                                {
                                    w_trim = w.trim();
                                    if(w_trim != "" && clean_words.size() < 2)
                                    {
                                        clean_words.add(w_trim);
                                    }
                                }
                                if(clean_words.size() >= 2)
                                {
                                    short_cust = clean_words.get(0) + " " + clean_words.get(1);
                                }
                                else if(clean_words.size() == 1)
                                {
                                    short_cust = clean_words.get(0);
                                }
                            }
                            
                            active_ids = list();
                            if(new_cu != null)
                            {
                                active_ids.add(new_cu);
                            }
                            if(new_ov != null && !active_ids.contains(new_ov))
                            {
                                active_ids.add(new_ov);
                            }
                            
                            dev_serial_map = map();
                            active_devs = list();
                            if(active_ids.size() > 0)
                            {
                                active_devs = Devices[ID in active_ids];
                                for each dev in active_devs
                                {
                                    dev_serial_map.put(dev.ID, dev.Serial_Number);
                                }
                            }
                            
                            new_summary = short_cust;
                            if(new_cu != null && dev_serial_map.containKey(new_cu))
                            {
                                new_summary = new_summary + " | " + dev_serial_map.get(new_cu);
                            }
                            if(new_ov != null && dev_serial_map.containKey(new_ov))
                            {
                                new_summary = new_summary + " | " + dev_serial_map.get(new_ov);
                            }
                            
                            if(old_state == "Rental")
                            {
                                new_billing_mode = old_billing_mode;
                                if(old_billing_mode == "Fixed Monthly")
                                {
                                    new_rental_rate = old_rental_rate;
                                    new_gst = old_gst;
                                    new_inv_amt = old_inv_amt;
                                    new_bill_day = old_bill_day;
                                    new_next_from = old_next_from;
                                    new_next_to = old_next_to;
                                    new_next_period = old_next_period;
                                    new_last_billed = old_last_billed;
                                    
                                    old_dep.Next_Billing_From = null;
                                    old_dep.Next_Billing_To = null;
                                    old_dep.Next_Billing_Period = null;
                                }
                                else if(old_billing_mode == "Pay Per Use")
                                {
                                    if(old_next_from != null)
                                    {
                                        if(swap_date < old_next_from)
                                        {
                                            old_dep.Next_Billing_From = null;
                                            old_dep.Next_Billing_To = null;
                                            old_dep.Next_Billing_Period = null;
                                        }
                                        else if(old_next_to != null && swap_date < old_next_to)
                                        {
                                            old_dep.Next_Billing_To = swap_date;
                                            old_dep.Next_Billing_Period = old_next_from.toString("dd MMM yy") + " - " + swap_date.toString("dd MMM yy");
                                        }
                                    }
                                    if(ppu_cycle.containKey("label"))
                                    {
                                        new_next_from = ppu_cycle.get("from");
                                        new_next_to = ppu_cycle.get("to");
                                        new_next_period = ppu_cycle.get("label");
                                    }
                                }
                            }
                            
                            old_dep.Deployment_State = "Closed";
                            old_dep.End_Date = swap_date;
                            
                            insert into Deployments
                            [
                                Customer = old_cust
                                Control_Unit = new_cu
                                Overlay = new_ov
                                Start_Date = swap_date
                                Deployment_State = old_state
                                Deployment_Summary = new_summary
                                Billing_Mode = new_billing_mode
                                Rental_Rate = new_rental_rate
                                GST_Amount = new_gst
                                Invoice_Amount = new_inv_amt
                                Billing_Day = new_bill_day
                                Next_Billing_From = new_next_from
                                Next_Billing_To = new_next_to
                                Next_Billing_Period = new_next_period
                                Last_Billed_Period = new_last_billed
                            ]
                            
                            out_ids = list();
                            if(old_cu != null && old_cu != new_cu)
                            {
                                out_ids.add(old_cu);
                            }
                            if(old_ov != null && old_ov != new_ov && !out_ids.contains(old_ov))
                            {
                                out_ids.add(old_ov);
                            }
                            
                            if(out_ids.size() > 0)
                            {
                                swapped_out_devs = Devices[ID in out_ids];
                                for each dev in swapped_out_devs
                                {
                                    dev.Device_Stage = device_condition;
                                    if(is_collected)
                                    {
                                        dev.Device_State = "Available in Stock";
                                        dev.Current_Customer = null;
                                        dev.Current_Office = return_office;
                                    }
                                    else
                                    {
                                        dev.Device_State = "Idle with Customer";
                                        dev.Current_Office = null;
                                    }
                                }
                            }
                            
                            target_active_state = "Rentally Active";
                            if(old_state == "Demo")
                            {
                                target_active_state = "Active in Demo";
                            }
                            else if(old_state == "Idle")
                            {
                                target_active_state = "Idle with Customer";
                            }
                            
                            if(active_ids.size() > 0)
                            {
                                for each dev in active_devs
                                {
                                    dev.Device_State = target_active_state;
                                    dev.Current_Customer = old_cust;
                                    dev.Current_Office = null;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    catch (e)
    {
        ctx = "Deployment=" + deployment_id + " | Control_Unit=" + new_cu + " | Overlay=" + new_ov + " | Swap_Date=" + swap_date + " | Collected=" + is_collected + " | Return_Office=" + return_office + " | Device_Condition=" + device_condition;
        err_msg = thisapp.format_error_log("handle_swap_devices", "scripts/functions/handle_swap_devices.deluge", "Swap_Devices -> Submit -> On Click", "" + e.lineNo, "" + e.type, "" + e.message, ctx);
    }
    return err_msg;
}
