// ==============================================================================
// Module Name  : Rental Agreements (Form Link Name: Rental_Agreements)
// Script Type  : Form Workflow
// Trigger Hook : Created or Edited -> Field Actions -> Rental_Item -> On User Input
// File Path    : scripts/06_rental_agreements/2_1_Rental_Agreements_onuserinput_rentalitem.deluge
// Fields Used  : [Rental_Item, Customer, Billing_Unit, Agreement_Start_Date, Agreement_Title]
// Cross-Forms  : [Rental_Items, Customers]
// Purpose      : When Rental Item is selected:
//                1. Defaults Agreement_Start_Date to today if empty.
//                2. Pulls Billing_Unit ("Day" or "Month") from Rental_Items silently in background.
//                3. Auto-fills Agreement_Title ([Customer] - [Item]), leaving user free to edit.
// Optimization : Single indexed lookup on Rental_Items and Customers.
// ==============================================================================

if(input.Rental_Item != null)
{
    // 1. Ensure Agreement Start Date is set to today if not already chosen
    if(input.Agreement_Start_Date == null)
    {
        input.Agreement_Start_Date = zoho.currentdate;
    }
    
    // 2. Fetch Rental Items details and silently populate Billing Unit in the background
    target_item_id = input.Rental_Item;
    item_rec = Rental_Items[ID == target_item_id];
    if(item_rec != null && item_rec.count() > 0)
    {
        item_name = ifnull(item_rec.Item_Name, "");
        b_unit = ifnull(item_rec.Billing_Unit, "");
        
        if(b_unit != null && b_unit != "")
        {
            input.Billing_Unit = b_unit;
        }
        else if(item_name.toLowerCase().contains("monthly") || item_name.toLowerCase().contains("month"))
        {
            input.Billing_Unit = "Month";
        }
        else
        {
            input.Billing_Unit = "Day";
        }
        
        // 3. Auto-fill Agreement Title (Customer Name - Rental Item Name)
        cust_name = "";
        if(input.Customer != null)
        {
            cust_id = input.Customer;
            cust_rec = Customers[ID == cust_id];
            cust_name = ifnull(cust_rec.Customer_Name, "");
        }
        
        if(cust_name != "")
        {
            input.Agreement_Title = cust_name + " - " + item_name;
        }
        else
        {
            input.Agreement_Title = item_name;
        }
    }
}
else
{
    // Selection cleared: Reset derived fields
    input.Billing_Unit = null;
    
    // Retain customer name if Customer is still selected, else clear
    if(input.Customer != null)
    {
        cust_id = input.Customer;
        cust_rec = Customers[ID == cust_id];
        input.Agreement_Title = ifnull(cust_rec.Customer_Name, "");
    }
    else
    {
        input.Agreement_Title = "";
    }
}
