// ==============================================================================
// Module Name  : Rental Agreements (Form Link Name: Rental_Agreements)
// Script Type  : Form Workflow (On Validate)
// Trigger Hook : Created or Edited -> Form Actions -> On Validate
// File Path    : scripts/06_rental_agreements/3_Rental_Agreements_onvalidate.deluge
// Fields Used  : [Customer, Rental_Item, Agreed_Rate, Agreement_Start_Date, Agreement_Title, Agreement_Status]
// Cross-Forms  : [Customers, Rental_Items, Rental_Agreements]
// Purpose      : Validates mandatory commercial fields, ensures rate > 0, enforces
//                single active Daily agreement guard (inspecting Rental_Item.Billing_Unit),
//                finalizes title with #Count+1, and guarantees strict uniqueness on Agreement_Title.
// Optimization : Max 3 indexed queries. Zero try-catch blocks. Law 1 compliant.
// ==============================================================================

curr_id = 0;
if(input.ID != null)
{
    curr_id = input.ID;
}

// 1. Mandatory Field Checks
if(input.Customer == null)
{
    alert "Customer is mandatory. Please select a customer from the lookup.";
    cancel submit;
}

if(input.Rental_Item == null)
{
    alert "Rental Item is mandatory. Please select an active rental item from Rental Items.";
    cancel submit;
}

if(input.Agreed_Rate == null || input.Agreed_Rate <= 0)
{
    alert "Agreed Rate is mandatory and must be greater than zero. Please enter the negotiated rental rate.";
    cancel submit;
}

// 2. Ensure Agreement Start Date is set
if(input.Agreement_Start_Date == null)
{
    input.Agreement_Start_Date = zoho.currentdate;
}

// 3. Ensure Agreement Title is finalized (Fallback generation if blank)
if(input.Agreement_Title == null || input.Agreement_Title.trim() == "")
{
    target_cust_id = input.Customer;
    target_item_id = input.Rental_Item;
    cust_rec = Customers[ID == target_cust_id];
    item_rec = Rental_Items[ID == target_item_id];
    cust_raw = ifnull(cust_rec.Customer_Name, "Customer").trim();
    item_raw = ifnull(item_rec.Item_Name, "Rental Item");
    
    // Extract first 3 words of Customer
    clean_cust = "";
    c_words = cust_raw.toList(" ");
    if(c_words.size() > 3)
    {
        clean_cust = c_words.get(0) + " " + c_words.get(1) + " " + c_words.get(2);
    }
    else
    {
        clean_cust = cust_raw;
    }
    
    // Clean item name
    clean_item = item_raw;
    clean_item = clean_item.replaceAll("™", "");
    clean_item = clean_item.replaceAll("®", "");
    clean_item = clean_item.replaceAll("Rental - ", "");
    clean_item = clean_item.replaceAll("Rental -", "");
    clean_item = clean_item.replaceAll("Rental ", "");
    clean_item = clean_item.trim();
    
    // Calculate Count + 1
    existing_agreements = Rental_Agreements[Customer == target_cust_id && ID != curr_id];
    next_num = existing_agreements.count() + 1;
    
    input.Agreement_Title = clean_cust + " - " + clean_item + " #" + next_num;
}

// 4. Strict Uniqueness Check on Agreement Title
target_title = input.Agreement_Title.trim();
existing_title = Rental_Agreements[Agreement_Title == target_title && ID != curr_id];
if(existing_title.count() > 0)
{
    alert "Duplicate Agreement Title:\n\nAn agreement with the title '" + target_title + "' already exists in the system.\n\nPlease enter a unique title or adjust the sequence number.";
    cancel submit;
}

// 5. Ensure Agreement Status is set
if(input.Agreement_Status == null)
{
    input.Agreement_Status = "Active";
}

// 6. Duplicate Guard for Daily (Pay-Per-Use) Agreements
target_item_id = input.Rental_Item;
item_check = Rental_Items[ID == target_item_id];
if(item_check != null && item_check.Billing_Unit == "Day")
{
    target_cust_id = input.Customer;
    
    existing_active = Rental_Agreements[Customer == target_cust_id && Rental_Item == target_item_id && Agreement_Status == "Active" && ID != curr_id];
    
    if(existing_active != null && existing_active.count() > 0)
    {
        alert "Duplicate Daily Agreement Prevented:\n\nAn active Daily (Pay-Per-Use) agreement already exists for this Customer and Item:\n" + existing_active.Agreement_Title.getAll() + "\n\nIn Cureous PRS, a customer only needs ONE active Daily agreement per product family. Multiple bed stations are managed under this single contract.";
        cancel submit;
    }
}
