// ==============================================================================
// Module Name  : Rental Agreements (Form Link Name: Rental_Agreements)
// Script Type  : Form Workflow
// Trigger Hook : Created or Edited -> Form Actions -> On Validate
// File Path    : scripts/06_rental_agreements/3_Rental_Agreements_onvalidate.deluge
// Fields Used  : [Customer, Rental_Item, Agreed_Rate, Rental_Agreement_ID, Agreement_Start_Date, Billing_Unit, Agreement_Title, Agreement_Status]
// Cross-Forms  : [Customers, Rental_Items, Rental_Agreements]
// Purpose      : Validates mandatory commercial fields, ensures rate > 0, enforces
//                single active Daily agreement guard, and finalizes title/ID/Billing Unit.
// Optimization : Max 2 indexed queries. Zero try-catch blocks.
// ==============================================================================

// 1. Mandatory Field Checks
if(input.Customer == null)
{
    alert "Customer is mandatory. Please select a customer from the lookup.";
    cancel submit;
}

if(input.Rental_Item == null)
{
    alert "Rental Item is mandatory. Please select an active rental item from Rental Items.";
    cancel submit;
}

if(input.Agreed_Rate == null || input.Agreed_Rate <= 0)
{
    alert "Agreed Rate is mandatory and must be greater than zero. Please enter the negotiated rental rate.";
    cancel submit;
}

// 2. Ensure Rental Agreement ID is populated
if(input.Rental_Agreement_ID == null || input.Rental_Agreement_ID.trim() == "")
{
    current_year = zoho.currentdate.getYear();
    agreement_count = Rental_Agreements[ID != null].count() + 1;
    formatted_seq = agreement_count.toString().leftPad(4).replaceAll(" ", "0");
    input.Rental_Agreement_ID = "RA-" + current_year + "-" + formatted_seq;
}

// 3. Ensure Agreement Start Date is set
if(input.Agreement_Start_Date == null)
{
    input.Agreement_Start_Date = zoho.currentdate;
}

// 4. Ensure Billing Unit is populated from Rental Items
if(input.Billing_Unit == null || input.Billing_Unit == "")
{
    target_item_id = input.Rental_Item;
    item_rec = Rental_Items[ID == target_item_id];
    if(item_rec.count() > 0)
    {
        b_unit = ifnull(item_rec.Billing_Unit, "");
        if(b_unit != null && b_unit != "")
        {
            input.Billing_Unit = b_unit;
        }
        else if(item_rec.Item_Name.toLowerCase().contains("monthly"))
        {
            input.Billing_Unit = "Month";
        }
        else
        {
            input.Billing_Unit = "Day";
        }
    }
}

// 5. Ensure Agreement Title is finalized
if(input.Agreement_Title == null || input.Agreement_Title.trim() == "")
{
    target_cust_id = input.Customer;
    target_item_id = input.Rental_Item;
    cust_rec = Customers[ID == target_cust_id];
    item_rec = Rental_Items[ID == target_item_id];
    cust_name = ifnull(cust_rec.Customer_Name, "Customer");
    item_name = ifnull(item_rec.Item_Name, "Rental Item");
    input.Agreement_Title = cust_name + " - " + item_name + " (" + input.Rental_Agreement_ID + ")";
}

// 6. Ensure Agreement Status is set
if(input.Agreement_Status == null)
{
    input.Agreement_Status = "Active";
}

// 7. Duplicate Guard for Daily (Pay-Per-Use) Agreements
if(input.Billing_Unit == "Day")
{
    target_cust_id = input.Customer;
    target_item_id = input.Rental_Item;
    
    if(input.ID == null)
    {
        existing_active = Rental_Agreements[Customer == target_cust_id && Rental_Item == target_item_id && Agreement_Status == "Active"];
        if(existing_active.count() > 0)
        {
            alert "Duplicate Daily Agreement Prevented:\n\nAn active Daily (Pay-Per-Use) agreement already exists for this Customer and Item:\n" + existing_active.Rental_Agreement_ID.getAll() + "\n\nIn Cureous PRS, a customer only needs ONE active Daily agreement per product family. Multiple bed stations are managed under this single contract.";
            cancel submit;
        }
    }
    else
    {
        curr_id = input.ID;
        existing_active = Rental_Agreements[Customer == target_cust_id && Rental_Item == target_item_id && Agreement_Status == "Active" && ID != curr_id];
        if(existing_active.count() > 0)
        {
            alert "Duplicate Daily Agreement Prevented:\n\nAnother active Daily agreement already exists for this Customer and Item:\n" + existing_active.Rental_Agreement_ID.getAll();
            cancel submit;
        }
    }
}
