// ==============================================================================
// Module Name  : Rental Agreements (Form Link Name: Rental_Agreements)
// Script Type  : Form Workflow
// Trigger Hook : Created or Edited -> Form Actions -> On Validate
// File Path    : scripts/06_rental_agreements/3_Rental_Agreements_onvalidate.deluge
// Fields Used  : [Customer, Rental_Item, Agreed_Rate, Agreement_Start_Date, Billing_Unit, Agreement_Title, Agreement_Status]
// Cross-Forms  : [Customers, Rental_Items, Rental_Agreements]
// Purpose      : Validates mandatory commercial fields, ensures rate > 0, enforces
//                single active Daily agreement guard, and finalizes title/Billing Unit in background.
// Optimization : Max 2 indexed queries. Zero try-catch blocks.
// ==============================================================================

// 1. Mandatory Field Checks
if(input.Customer == null)
{
    alert "Customer is mandatory. Please select a customer from the lookup.";
    cancel submit;
}

if(input.Rental_Item == null)
{
    alert "Rental Item is mandatory. Please select an active rental item from Rental Items.";
    cancel submit;
}

if(input.Agreed_Rate == null || input.Agreed_Rate <= 0)
{
    alert "Agreed Rate is mandatory and must be greater than zero. Please enter the negotiated rental rate.";
    cancel submit;
}

// 2. Ensure Agreement Start Date is set
if(input.Agreement_Start_Date == null)
{
    input.Agreement_Start_Date = zoho.currentdate;
}

// 3. Ensure Billing Unit is populated from Rental Items (Background safety guard)
if(input.Billing_Unit == null || input.Billing_Unit == "")
{
    target_item_id = input.Rental_Item;
    item_rec = Rental_Items[ID == target_item_id];
    if(item_rec != null && item_rec.count() > 0)
    {
        b_unit = ifnull(item_rec.Billing_Unit, "");
        if(b_unit != null && b_unit != "")
        {
            input.Billing_Unit = b_unit;
        }
        else if(item_rec.Item_Name.toLowerCase().contains("monthly") || item_rec.Item_Name.toLowerCase().contains("month"))
        {
            input.Billing_Unit = "Month";
        }
        else
        {
            input.Billing_Unit = "Day";
        }
    }
}

// 4. Ensure Agreement Title is finalized (with smart auto-cleaning)
if(input.Agreement_Title == null || input.Agreement_Title.trim() == "")
{
    target_cust_id = input.Customer;
    target_item_id = input.Rental_Item;
    cust_rec = Customers[ID == target_cust_id];
    item_rec = Rental_Items[ID == target_item_id];
    cust_raw = ifnull(cust_rec.Customer_Name, "Customer");
    item_raw = ifnull(item_rec.Item_Name, "Rental Item");
    
    clean_item = item_raw;
    clean_item = clean_item.replaceAll("Rental - ", "");
    clean_item = clean_item.replaceAll("Rental -", "");
    clean_item = clean_item.replaceAll("™", "");
    clean_item = clean_item.replaceAll("®", "");
    clean_item = clean_item.replaceAll(" - Monthly", " (Monthly)");
    clean_item = clean_item.replaceAll("- Monthly", " (Monthly)");
    clean_item = clean_item.replaceAll(" - Daily", " (Daily)");
    clean_item = clean_item.replaceAll("- Daily", " (Daily)");
    clean_item = clean_item.trim();
    
    clean_cust = cust_raw;
    clean_cust = clean_cust.replaceAll(" Private Limited", "");
    clean_cust = clean_cust.replaceAll(" Pvt Ltd", "");
    clean_cust = clean_cust.replaceAll(" Pvt. Ltd.", "");
    clean_cust = clean_cust.replaceAll(" Pvt. Ltd", "");
    clean_cust = clean_cust.replaceAll(" Limited", "");
    clean_cust = clean_cust.replaceAll(" Ltd.", "");
    clean_cust = clean_cust.replaceAll(" Ltd", "");
    clean_cust = clean_cust.replaceAll(" & Research Centre", "");
    clean_cust = clean_cust.replaceAll(" and Research Centre", "");
    clean_cust = clean_cust.replaceAll(" & Research Center", "");
    clean_cust = clean_cust.replaceAll(" and Research Center", "");
    clean_cust = clean_cust.replaceAll(" Multispeciality Hospital", " Hospital");
    clean_cust = clean_cust.replaceAll(" Multispecialty Hospital", " Hospital");
    clean_cust = clean_cust.replaceAll(" Super Speciality Hospital", " Hospital");
    clean_cust = clean_cust.replaceAll(" Superspeciality Hospital", " Hospital");
    clean_cust = clean_cust.replaceAll(" Multispeciality", "");
    clean_cust = clean_cust.replaceAll(" Multispecialty", "");
    clean_cust = clean_cust.replaceAll(" Superspeciality", "");
    clean_cust = clean_cust.replaceAll(" Super Speciality", "");
    clean_cust = clean_cust.trim();
    
    if(clean_cust.length() > 30)
    {
        c_words = clean_cust.toList(" ");
        if(c_words.size() > 3)
        {
            clean_cust = c_words.get(0) + " " + c_words.get(1) + " " + c_words.get(2);
        }
    }
    
    input.Agreement_Title = clean_cust + " - " + clean_item;
}

// 5. Ensure Agreement Status is set
if(input.Agreement_Status == null)
{
    input.Agreement_Status = "Active";
}

// 6. Duplicate Guard for Daily (Pay-Per-Use) Agreements
if(input.Billing_Unit == "Day")
{
    target_cust_id = input.Customer;
    target_item_id = input.Rental_Item;
    
    existing_active = null;
    if(input.ID == null)
    {
        existing_active = Rental_Agreements[Customer == target_cust_id && Rental_Item == target_item_id && Agreement_Status == "Active"];
    }
    else
    {
        curr_id = input.ID;
        existing_active = Rental_Agreements[Customer == target_cust_id && Rental_Item == target_item_id && Agreement_Status == "Active" && ID != curr_id];
    }
    
    if(existing_active != null && existing_active.count() > 0)
    {
        alert "Duplicate Daily Agreement Prevented:\n\nAn active Daily (Pay-Per-Use) agreement already exists for this Customer and Item:\n" + existing_active.Agreement_Title.getAll() + "\n\nIn Cureous PRS, a customer only needs ONE active Daily agreement per product family. Multiple bed stations are managed under this single contract.";
        cancel submit;
    }
}
