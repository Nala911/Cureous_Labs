// ==============================================================================
// Module Name  : Offices (Form Link Name: Offices)
// Script Type  : Form Workflow (On Validate)
// Trigger Hook : Created or Edited -> Form Actions -> On Validate
// File Path    : scripts/03_offices/3_Offices_onvalidate.deluge
// Fields Used  : [Office_Name]
// Cross-Forms  : [Offices]
// Purpose      : Enforces mandatory Office_Name, trims extra whitespace, and
//                prevents duplicate branch office names across Offices.
// Optimization : Single indexed lookup against Offices. Zero loop queries.
// ==============================================================================

if(input.Office_Name == null || input.Office_Name.trim() == "")
{
    alert "Mandatory Field Missing:\n\nPlease enter an Office Name.";
    cancel submit;
}

clean_name = input.Office_Name.trim();
input.Office_Name = clean_name;

curr_id = 0;
if(input.ID != null)
{
    curr_id = input.ID;
}

dup_offices = Offices[Office_Name == clean_name && ID != curr_id];
if(dup_offices.count() > 0)
{
    alert "Duplicate Office Name:\n\nOffice '" + clean_name + "' already exists in the registry.";
    cancel submit;
}
