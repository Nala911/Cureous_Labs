// ==============================================================================
// Module Name  : Offices (Form Link Name: Offices)
// Script Type  : Form Workflow (On Success)
// Trigger Hook : Created or Edited -> Form Actions -> On Success
// File Path    : scripts/03_offices/4_Offices_onsuccess.deluge
// Fields Used  : [Is_Primary]
// Cross-Forms  : [Offices]
// Purpose      : Enforces the Single Primary Hub rule across all offices and
//                redirects cleanly to the 'All_Offices' report view.
// Optimization : Atomic update on existing primary hub only if changed.
//                Minimal statements. Standardized to single-line comments.
// ==============================================================================

// 1. Single Primary Hub Enforcement
if(input.Is_Primary == true)
{
    // Unset Is_Primary on any other existing offices
    other_primaries = Offices[Is_Primary == true && ID != input.ID];
    for each other_hub in other_primaries
    {
        other_hub.Is_Primary = false;
    }
}

// 2. Redirect cleanly to the All_Offices report view (instantly dismisses submit loader)
openUrl("#Report:All_Offices", "same window");
