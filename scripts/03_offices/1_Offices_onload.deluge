// ==============================================================================
// Module Name  : Offices (Form Link Name: Offices)
// Script Type  : Form Workflow (On Load)
// Trigger Hook : Created or Edited -> Form Actions -> On Load
// File Path    : scripts/03_offices/1_Offices_onload.deluge
// Fields Used  : [Office_Name]
// Cross-Forms  : None
// Purpose      : Ensures Office_Name is visible and enabled in both Add and Edit
//                modes cleanly via Deluge rather than native Form Rules.
// Optimization : Zero database queries. Runs in <1ms.
// ==============================================================================

show Office_Name;
enable Office_Name;
