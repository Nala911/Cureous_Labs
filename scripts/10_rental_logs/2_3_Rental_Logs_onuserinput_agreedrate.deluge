// ==============================================================================
// Module Name  : Rental Logs (Form Link Name: Rental_Logs)
// Script Type  : Form Workflow
// Trigger Hook : Created or Edited -> Field Actions -> Agreed_Rate -> On User Input
// File Path    : scripts/10_rental_logs/2_3_Rental_Logs_onuserinput_agreedrate.deluge
// Fields Used  : [Bed_Station, Agreed_Rate, Number_of_Days, Taxable_Value]
// Cross-Forms  : [Bed_Stations, Rental_Agreements]
// Purpose      : Recalculates taxable value when Agreed Rate is updated.
//                (GST and Invoice Amount calculate automatically via native formula fields).
// Optimization : Mathematical in-memory evaluation with max 2 indexed queries.
// ==============================================================================

if(input.Agreed_Rate == null || input.Agreed_Rate <= 0)
{
    input.Taxable_Value = 0.00;
}
else
{
    is_monthly = false;
    if(input.Bed_Station != null)
    {
        b_id = input.Bed_Station;
        b_rec = Bed_Stations[ID == b_id];
        if(b_rec != null && b_rec.Rental_Agreement != null)
        {
            ag_id = b_rec.Rental_Agreement;
            ag_rec = Rental_Agreements[ID == ag_id];
            if(ag_rec != null && ag_rec.Billing_Unit == "Month")
            {
                is_monthly = true;
            }
        }
    }
    
    if(is_monthly)
    {
        input.Taxable_Value = input.Agreed_Rate;
    }
    else
    {
        // Default: Pay Per Use (Daily)
        days = ifnull(input.Number_of_Days, 1);
        input.Taxable_Value = days * input.Agreed_Rate;
    }
}
