// ==============================================================================
// Module Name  : Rental Logs (Form Link Name: Rental_Logs)
// Script Type  : Form Workflow
// Trigger Hook : Created or Edited -> Field Actions -> Agreed_Rate -> On User Input
// File Path    : scripts/10_rental_logs/2_3_Rental_Logs_onuserinput_agreedrate.deluge
// Fields Used  : [Agreed_Rate, Number_of_Days, Rental_Mode, Taxable_Value, GST_Rate, GST_Amount, Invoice_Amount]
// Cross-Forms  : None
// Purpose      : Recalculates taxable value, statutory GST, and grand invoice amount when Agreed Rate is updated.
// Optimization : Mathematical in-memory evaluation with zero database overhead.
// ==============================================================================

if(input.Agreed_Rate == null || input.Agreed_Rate <= 0)
{
    input.Taxable_Value = 0.00;
    input.GST_Amount = 0.00;
    input.Invoice_Amount = 0.00;
}
else
{
    // Determine base taxable value based on active rental mode
    if(input.Rental_Mode == "Fixed Monthly Rental")
    {
        input.Taxable_Value = input.Agreed_Rate;
    }
    else
    {
        // Default: Pay Per Use (Daily)
        days = ifnull(input.Number_of_Days, 1);
        input.Taxable_Value = days * input.Agreed_Rate;
    }
    
    // Apply statutory GST Rate (default 5.00%)
    gst_pct = 0.05;
    if(input.GST_Rate != null && input.GST_Rate > 0)
    {
        gst_pct = input.GST_Rate / 100.0;
    }
    
    input.GST_Amount = input.Taxable_Value * gst_pct;
    input.Invoice_Amount = input.Taxable_Value + input.GST_Amount;
}
