// ==============================================================================
// Module Name  : Rental Logs (Form Link Name: Rental_Logs)
// Script Type  : Form Workflow
// Trigger Hook : Created or Edited -> Field Actions -> Days_Used -> On User Input
// File Path    : scripts/10_rental_logs/2_3_Rental_Logs_onuserinput_daysused.deluge
// Fields Used  : [Days_Used, Usage_Start_Date, Usage_End_Date, Billing_Type, Agreed_Rate, Taxable_Value]
// Cross-Forms  : None
// Purpose      : Enforces that Days Used is positive and within the selected period range.
//                Recalculates Taxable Value for Pay-Per-Use and prorates for Fixed Monthly if days are reduced.
// Optimization : Pure mathematical in-memory evaluation with zero database queries.
// ==============================================================================

if(input.Days_Used != null)
{
    // Guard against non-positive days
    if(input.Days_Used <= 0)
    {
        alert "Days Used must be at least 1 day.";
        input.Days_Used = 1;
    }
    
    tot_days = 0;
    if(input.Usage_Start_Date != null && input.Usage_End_Date != null)
    {
        if(input.Usage_End_Date >= input.Usage_Start_Date)
        {
            tot_days = input.Usage_Start_Date.daysBetween(input.Usage_End_Date) + 1;
            if(input.Days_Used > tot_days)
            {
                alert "Days Used (" + input.Days_Used + ") exceeds total calendar days in the selected period (" + tot_days + "). Resetting to period duration.";
                input.Days_Used = tot_days;
            }
        }
    }
    
    // Recalculate Taxable Value
    if(input.Agreed_Rate != null)
    {
        if(input.Billing_Type == "Fixed (Monthly)")
        {
            if(tot_days > 0 && input.Days_Used < tot_days)
            {
                // Prorate if user reduced days below full period
                c_d = tot_days.toDecimal();
                u_d = input.Days_Used.toDecimal();
                r = input.Agreed_Rate.toDecimal();
                input.Taxable_Value = ((r / c_d) * u_d).round(2);
            }
            else
            {
                input.Taxable_Value = input.Agreed_Rate;
            }
        }
        else
        {
            // Pay-Per-Use (Daily)
            input.Taxable_Value = input.Days_Used * input.Agreed_Rate;
        }
    }
}
