// ==============================================================================
// Module Name  : Rental Logs (Form Link Name: Rental_Logs)
// Script Type  : Form Workflow (On Load)
// Trigger Hook : Created or Edited -> Form Actions -> On Load
// File Path    : scripts/10_rental_logs/1_Rental_Logs_onload.deluge
// Fields Used  : [Bed_Station, Control_Unit, Overlay, Usage_Start_Date, Usage_End_Date, Agreed_Rate, Number_of_Days, Taxable_Value, Billing_Status]
// Cross-Forms  : None
// Purpose      : Controls field accessibility and initializes initial billing status.
//                Hides Billing_Status on Add (defaults to Pending Invoice); shows
//                Billing_Status in Edit mode. Locks inputs if already invoiced.
// Optimization : Pure UI manipulation with zero database queries. Law 1 & Law 5 compliant.
// ==============================================================================

// Disable auto-derived context fields on both Add and Edit
disable Taxable_Value;
disable Billing_Status;

// Conditional logic for Add mode vs Edit mode
if(input.ID == null)
{
    // ADD MODE: Enable interactive user entry fields
    enable Bed_Station;
    enable Control_Unit;
    enable Overlay;
    enable Usage_Start_Date;
    enable Usage_End_Date;
    enable Agreed_Rate;
    enable Number_of_Days;
    
    // Set initial billing status and hide from user on entry
    input.Billing_Status = "Pending Invoice";
    hide Billing_Status;
}
else
{
    // EDIT MODE: Show Billing Status and lock primary relational anchor
    show Billing_Status;
    disable Bed_Station;
    
    // Check if record is still pending invoice
    if(input.Billing_Status == "Pending Invoice")
    {
        enable Control_Unit;
        enable Overlay;
        enable Usage_Start_Date;
        enable Usage_End_Date;
        enable Agreed_Rate;
        enable Number_of_Days;
    }
    else
    {
        // Locked if Invoiced or Cancelled
        disable Control_Unit;
        disable Overlay;
        disable Usage_Start_Date;
        disable Usage_End_Date;
        disable Agreed_Rate;
        disable Number_of_Days;
    }
}
