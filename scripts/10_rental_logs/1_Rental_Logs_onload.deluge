// ==============================================================================
// Module Name  : Rental Logs (Form Link Name: Rental_Logs)
// Script Type  : Form Workflow (On Load)
// Trigger Hook : Created or Edited -> Form Actions -> On Load
// File Path    : scripts/10_rental_logs/1_Rental_Logs_onload.deluge
// Fields Used  : [Bed_Station, Customer, Rental_Agreement, Rental_Item, Billing_Type, Control_Unit, Overlay, Usage_Start_Date, Usage_End_Date, Days_Used, Agreed_Rate, Taxable_Value, Notes, Billing_Status]
// Cross-Forms  : None
// Purpose      : Controls field accessibility and initializes default billing status.
//                Locks relational context fields; configures input controls for Add/Edit modes.
// Optimization : Pure UI manipulation with zero database queries. Law 1 & Law 5 compliant.
// ==============================================================================

// Disable auto-derived relational context fields on both Add and Edit
disable Customer;
disable Rental_Agreement;
disable Rental_Item;
disable Billing_Type;
disable Billing_Status;

// Conditional logic for Add mode vs Edit mode
if(input.ID == null)
{
    // ADD MODE: Enable interactive user entry fields
    enable Bed_Station;
    enable Control_Unit;
    enable Overlay;
    enable Usage_Start_Date;
    enable Usage_End_Date;
    enable Days_Used;
    enable Agreed_Rate;
    enable Taxable_Value;
    enable Notes;
    
    // Hide lifecycle status on creation and set initial default
    hide Billing_Status;
    input.Billing_Status = "Pending Invoice";
}
else
{
    // EDIT MODE: Show Billing Status and lock primary relational anchor
    show Billing_Status;
    disable Bed_Station;
    
    // Check if record is still pending invoice
    if(input.Billing_Status == "Pending Invoice")
    {
        enable Control_Unit;
        enable Overlay;
        enable Usage_Start_Date;
        enable Usage_End_Date;
        enable Days_Used;
        enable Agreed_Rate;
        enable Taxable_Value;
        enable Notes;
    }
    else
    {
        // Locked if already Invoiced or Cancelled
        disable Control_Unit;
        disable Overlay;
        disable Usage_Start_Date;
        disable Usage_End_Date;
        disable Days_Used;
        disable Agreed_Rate;
        disable Taxable_Value;
        disable Notes;
    }
}
