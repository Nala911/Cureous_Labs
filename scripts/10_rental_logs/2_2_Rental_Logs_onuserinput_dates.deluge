// ==============================================================================
// Module Name  : Rental Logs (Form Link Name: Rental_Logs)
// Script Type  : Form Workflow
// Trigger Hook : Created or Edited -> Field Actions -> Usage_Start_Date / Usage_End_Date -> On User Input
// File Path    : scripts/10_rental_logs/2_2_Rental_Logs_onuserinput_dates.deluge
// Fields Used  : [Bed_Station, Usage_Start_Date, Usage_End_Date, Number_of_Days, Agreed_Rate, Taxable_Value]
// Cross-Forms  : [Bed_Stations, Rental_Agreements]
// Purpose      : Validates chronological date order, computes inclusive usage days,
//                and updates taxable amount. (GST and Invoice Amount calculate
//                automatically via native formula fields).
// Optimization : Mathematical in-memory evaluation with max 2 indexed queries.
// ==============================================================================

if(input.Usage_Start_Date != null && input.Usage_End_Date != null)
{
    // Date sanity check
    if(input.Usage_End_Date < input.Usage_Start_Date)
    {
        alert "Usage End Date cannot be earlier than Usage Start Date.";
        input.Usage_End_Date = null;
        input.Number_of_Days = null;
        input.Taxable_Value = null;
    }
    else
    {
        // Compute inclusive days: (End - Start) + 1
        num_days = input.Usage_Start_Date.daysBetween(input.Usage_End_Date) + 1;
        input.Number_of_Days = num_days;
        
        // Recalculate commercial taxable value if Agreed Rate is present
        if(input.Agreed_Rate != null)
        {
            is_monthly = false;
            if(input.Bed_Station != null)
            {
                b_id = input.Bed_Station;
                b_rec = Bed_Stations[ID == b_id];
                if(b_rec != null && b_rec.Rental_Agreement != null)
                {
                    ag_id = b_rec.Rental_Agreement;
                    ag_rec = Rental_Agreements[ID == ag_id];
                    if(ag_rec != null && ag_rec.Rental_Item != null)
                    {
                        r_item_id = ag_rec.Rental_Item;
                        r_item = Rental_Items[ID == r_item_id];
                        if(r_item != null && r_item.Billing_Unit == "Month")
                        {
                            is_monthly = true;
                        }
                    }
                }
            }
            
            if(is_monthly)
            {
                input.Taxable_Value = input.Agreed_Rate;
            }
            else
            {
                // Standard Pay Per Use (Daily) calculation
                input.Taxable_Value = num_days * input.Agreed_Rate;
            }
        }
    }
}
