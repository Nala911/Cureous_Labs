// ==============================================================================
// Module Name  : Rental Logs (Form Link Name: Rental_Logs)
// Script Type  : Form Workflow
// Trigger Hook : Created or Edited -> Field Actions -> Usage_Start_Date / Usage_End_Date -> On User Input
// File Path    : scripts/10_rental_logs/2_2_Rental_Logs_onuserinput_dates.deluge
// Fields Used  : [Usage_Start_Date, Usage_End_Date, Days_Used, Billing_Type, Agreed_Rate, Taxable_Value]
// Cross-Forms  : None
// Purpose      : Validates chronological date order, computes default Days Used,
//                and updates Taxable Value based on billing model.
// Optimization : Pure in-memory date arithmetic with zero database queries.
// ==============================================================================

if(input.Usage_Start_Date != null && input.Usage_End_Date != null)
{
    // Chronological order sanity check
    if(input.Usage_End_Date < input.Usage_Start_Date)
    {
        alert "Usage End Date cannot be earlier than Usage Start Date.";
        input.Usage_End_Date = null;
        input.Days_Used = null;
        input.Taxable_Value = null;
    }
    else
    {
        // Compute total inclusive days: (End - Start) + 1
        tot_days = input.Usage_Start_Date.daysBetween(input.Usage_End_Date) + 1;
        input.Days_Used = tot_days;
        
        // Recalculate commercial taxable value if Agreed Rate is present
        if(input.Agreed_Rate != null)
        {
            if(input.Billing_Type == "Fixed (Monthly)")
            {
                input.Taxable_Value = input.Agreed_Rate;
            }
            else
            {
                // Pay-Per-Use (Daily) calculation
                input.Taxable_Value = input.Days_Used * input.Agreed_Rate;
            }
        }
    }
}
