// ==============================================================================
// Module Name  : Rental Items (Form Link Name: Rental_Items)
// Script Type  : Form Workflow (On Load)
// Trigger Hook : Created or Edited -> Form Actions -> On Load
// File Path    : scripts/04_rental_items/1_Rental_Items_onload.deluge
// Fields Used  : [Product_Model, Billing_Unit, Item_Name]
// Cross-Forms  : [Rental_Items]
// Purpose      : Enables Billing_Unit and Product_Model for user editing. Populates
//                Item_Name dropdown choices with active Zoho Books rental items
//                and standard options.
// Optimization : Native Zoho Books integration call with graceful fallback.
// ==============================================================================

// 1. Ensure Product_Model and Billing_Unit are visible and editable
show Product_Model;
enable Product_Model;
show Billing_Unit;
enable Billing_Unit;

// 2. Edit Mode Protection: Disallow altering existing item record
if(input.ID != null)
{
    disable Item_Name;
}
else
{
    // 3. In Add mode: Fetch active rental items from Zoho Books via native integration
    existing_items = Rental_Items[ID != null].Item_Name.getAll();
    item_names = list();
    
    org_id = "";
    org_resp = zoho.books.getOrganizations();
    if(org_resp != null && org_resp.get("code") == 0)
    {
        org_list = org_resp.get("organizations");
        if(org_list != null && org_list.size() > 0)
        {
            org_id = org_list.get(0).get("organization_id").toString();
        }
    }
    
    if(org_id != "")
    {
        query_params = "filter_by=Status.Active&per_page=200";
        books_resp = zoho.books.getRecords("items", org_id, query_params);
        
        if(books_resp != null && books_resp.get("code") == 0 && books_resp.get("items") != null)
        {
            for each itm in books_resp.get("items")
            {
                itm_name = itm.get("name");
                itm_status = itm.get("status");
                
                // Only include active items starting with "Rental" (case-insensitive) not already added in Creator
                if(itm_name != null && itm_name != "" && itm_status == "active")
                {
                    if(itm_name.trim().toLowerCase().startsWith("rental") && !existing_items.contains(itm_name))
                    {
                        item_names.add(itm_name);
                    }
                }
            }
        }
    }
    
    // Fallback: If Books returned no items or integration is inactive, load standard options
    if(item_names.size() == 0)
    {
        default_options = {"Rental - Altern4™ - Daily", "Rental - Altern4™ - Monthly", "Rental - ETURNAL HOME- Monthly", "Rental - ETURNAL Hospital™ - Daily", "Rental - Eturnal One™ - Daily", "Rental - Eturnal One™ - Monthly"};
        for each opt in default_options
        {
            if(!existing_items.contains(opt))
            {
                item_names.add(opt);
            }
        }
    }
    
    item_names.sort();
    
    // Populate dropdown choices
    clear Item_Name;
    Item_Name:ui.add(item_names);
}
