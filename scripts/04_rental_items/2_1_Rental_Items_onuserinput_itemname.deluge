// ==============================================================================
// Module Name  : Rental Items (Form Link Name: Rental_Items)
// Script Type  : Form Workflow (On User Input)
// Trigger Hook : Field Actions -> Item_Name -> On User Input
// File Path    : scripts/04_rental_items/2_1_Rental_Items_onuserinput_itemname.deluge
// Fields Used  : [Item_Name, Product_Model, Billing_Unit]
// Cross-Forms  : [Rental_Items, Product_Model]
// Purpose      : Instant Auto-Derive on item selection:
//                1. Parses "Daily" / "Monthly" -> Billing_Unit ("Day" | "Month")
//                2. Looks up Product Model ("Altern4" | "Eturnal") in Product_Model master
//                3. Leaves Billing_Unit and Product_Model editable by the user
//                4. Fast duplicate check alerting user if item is already onboarded
// Optimization : Single indexed query for duplicate check, single indexed query for Product_Model.
// ==============================================================================

selected_item = ifnull(input.Item_Name, "").trim();

if(selected_item != "")
{
    name_lower = selected_item.toLowerCase();
    
    // 1. Instant Auto-Derive Billing Unit ("Day" or "Month")
    if(name_lower.contains("daily") || name_lower.contains("day"))
    {
        input.Billing_Unit = "Day";
    }
    else if(name_lower.contains("monthly") || name_lower.contains("month"))
    {
        input.Billing_Unit = "Month";
    }
    else
    {
        input.Billing_Unit = null;
    }
    
    // 2. Instant Auto-Derive Product Model Lookup ("Altern4" or "Eturnal")
    target_pm_name = "";
    if(name_lower.contains("altern4") || name_lower.contains("altern"))
    {
        target_pm_name = "Altern4";
    }
    else if(name_lower.contains("eturnal"))
    {
        target_pm_name = "Eturnal";
    }
    
    if(target_pm_name != "")
    {
        p_name = target_pm_name;
        pm_rec = Product_Model[Product_Model_Name == p_name];
        if(pm_rec != null)
        {
            input.Product_Model = pm_rec.ID;
        }
        else
        {
            input.Product_Model = null;
        }
    }
    else
    {
        input.Product_Model = null;
    }
    
    // 3. User Permission: Ensure Billing_Unit and Product_Model remain fully editable
    enable Billing_Unit;
    enable Product_Model;
    
    // 4. Fast Duplicate Guard Check
    target_name = selected_item;
    existing_items = null;
    if(input.ID != null)
    {
        curr_id = input.ID;
        existing_items = Rental_Items[Item_Name == target_name && ID != curr_id];
    }
    else
    {
        existing_items = Rental_Items[Item_Name == target_name];
    }
    
    if(existing_items != null && existing_items.count() > 0)
    {
        alert "Item Already Onboarded:\n\n'" + target_name + "' is already registered in Rental Items.\n\nPlease select an un-onboarded item from the list.";
    }
}
else
{
    // Selection cleared: Reset dependent fields
    input.Billing_Unit = null;
    input.Product_Model = null;
}
