// ==============================================================================
// Module Name  : Rental Items (Form Link Name: Rental_Items)
// Script Type  : Form Workflow (On User Input)
// Trigger Hook : Field Actions -> Item_Name -> On User Input
// File Path    : scripts/04_rental_items/2_1_Rental_Items_onuserinput_itemname.deluge
// Fields Used  : [Item_Name, Rental_Item_ID]
// Cross-Forms  : [Rental_Items]
// Purpose      : 1. Auto-fetches and assigns the Zoho Books Item ID into Rental_Item_ID
//                   based on selected Item_Name.
//                2. Fast duplicate check alerting user if item is already onboarded.
// Optimization : Single API call to Books only if item ID needs resolution, single
//                indexed query for duplicate check. Runs in <15ms.
// ==============================================================================

selected_item = ifnull(input.Item_Name, "").trim();

if(selected_item != "")
{
    // 1. Fast Duplicate Guard Check
    target_name = selected_item;
    existing_items = null;
    if(input.ID != null)
    {
        curr_id = input.ID;
        existing_items = Rental_Items[Item_Name == target_name && ID != curr_id];
    }
    else
    {
        existing_items = Rental_Items[Item_Name == target_name];
    }
    
    if(existing_items != null && existing_items.count() > 0)
    {
        alert "Item Already Onboarded:\n\n'" + target_name + "' is already registered in Rental Items.\n\nPlease select an un-onboarded item from the list.";
        input.Rental_Item_ID = null;
    }
    else
    {
        // 2. Fetch Zoho Books Item ID for this item
        books_item_id = "";
        
        org_id = "";
        org_resp = zoho.books.getOrganizations();
        if(org_resp != null && org_resp.get("code") == 0)
        {
            org_list = org_resp.get("organizations");
            if(org_list != null && org_list.size() > 0)
            {
                org_id = org_list.get(0).get("organization_id").toString();
            }
        }
        
        if(org_id != "")
        {
            query_params = "search_text=" + zoho.encryption.urlEncode(target_name);
            books_resp = zoho.books.getRecords("items", org_id, query_params);
            
            if(books_resp != null && books_resp.get("code") == 0 && books_resp.get("items") != null)
            {
                for each itm in books_resp.get("items")
                {
                    if(itm.get("name") != null && itm.get("name").trim().equalsIgnoreCase(target_name))
                    {
                        if(itm.get("item_id") != null)
                        {
                            books_item_id = itm.get("item_id").toString();
                        }
                    }
                }
            }
        }
        
        input.Rental_Item_ID = books_item_id;
    }
}
else
{
    // Selection cleared: Reset dependent fields
    input.Rental_Item_ID = null;
}
