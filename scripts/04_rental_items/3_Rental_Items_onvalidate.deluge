// ==============================================================================
// Module Name  : Rental Items (Form Link Name: Rental_Items)
// Script Type  : Form Workflow (On Validate)
// Trigger Hook : Created or Edited -> Form Actions -> On Validate
// File Path    : scripts/04_rental_items/3_Rental_Items_onvalidate.deluge
// Fields Used  : [Item_Name, Billing_Unit, Product_Model]
// Cross-Forms  : [Rental_Items, Product_Model]
// Purpose      : Pre-submission validation guard:
//                1. Enforces mandatory Item_Name
//                2. Duplicate check against Rental_Items by Item_Name
//                3. Safety fallback: auto-derives Billing_Unit and Product_Model ("Altern4" | "Eturnal") if empty
//                4. Guarantees 100% clean data before record commit
// Optimization : Single indexed query for duplicate check, single indexed query for Product_Model fallback.
// ==============================================================================

// 1. Mandatory Check: Item Name
if(input.Item_Name == null || input.Item_Name == "")
{
    alert "Mandatory Field Missing:\n\nPlease select an Item Name.";
    cancel submit;
}

// 2. Duplicate Check on Item Name
target_name = input.Item_Name;
existing_by_name = null;

if(input.ID != null)
{
    curr_id = input.ID;
    existing_by_name = Rental_Items[Item_Name == target_name && ID != curr_id];
}
else
{
    existing_by_name = Rental_Items[Item_Name == target_name];
}

if(existing_by_name != null && existing_by_name.count() > 0)
{
    alert "Duplicate Item Name:\n\n'" + target_name + "' is already registered in Rental Items.";
    cancel submit;
}

// 3. Safety Fallback for Derived Fields
name_lower = input.Item_Name.toLowerCase();

if(input.Billing_Unit == null || input.Billing_Unit == "")
{
    if(name_lower.contains("daily") || name_lower.contains("day"))
    {
        input.Billing_Unit = "Day";
    }
    else if(name_lower.contains("monthly") || name_lower.contains("month"))
    {
        input.Billing_Unit = "Month";
    }
}

// Safety Fallback for Product Model Lookup ("Altern4" or "Eturnal")
if(input.Product_Model == null)
{
    fallback_pm = "";
    if(name_lower.contains("altern4") || name_lower.contains("altern"))
    {
        fallback_pm = "Altern4";
    }
    else if(name_lower.contains("eturnal"))
    {
        fallback_pm = "Eturnal";
    }
    
    if(fallback_pm != "")
    {
        m_name = fallback_pm;
        pm_rec = Product_Model[Product_Model_Name == m_name];
        if(pm_rec != null)
        {
            input.Product_Model = pm_rec.ID;
        }
    }
}

if(input.Product_Model == null)
{
    alert "Product Model Missing:\n\nPlease select a matching Product Model for '" + input.Item_Name + "'.";
    cancel submit;
}
